@h2 requests/packages/chardet/__init__.py [#file--requests-packages-chardet-__init__-py]

@x-symbol desc="def detect(aBuf)" file="requests/packages/chardet/__init__.py" qual="detect" lineno=22 endline=32 [#requests-packages-chardet-__init__-py--f-detect]
~~~
def detect(aBuf):
    if ((version_info < (3, 0) and isinstance(aBuf, unicode)) or
            (version_info >= (3, 0) and not isinstance(aBuf, bytes))):
        raise ValueError('Expected a bytes object, not a unicode object')

    from . import universaldetector
    u = universaldetector.UniversalDetector()
    u.reset()
    u.feed(aBuf)
    u.close()
    return u.result
~~~

