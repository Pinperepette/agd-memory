@x-symbol desc="def test_POSTBIN_GET_POST_FILES(self)" file="test_requests.py" qual="RequestsTestCase.test_POSTBIN_GET_POST_FILES" lineno=348 endline=364 refs="#test_requests-py--f-httpbin" [#test_requests-py--c-requeststestcase--m-test_postbin_get_post_files]
~~~
    def test_POSTBIN_GET_POST_FILES(self):

        url = httpbin('post')
        post1 = requests.post(url).raise_for_status()

        post1 = requests.post(url, data={'some': 'data'})
        assert post1.status_code == 200

        with open('requirements.txt') as f:
            post2 = requests.post(url, files={'some': f})
        assert post2.status_code == 200

        post4 = requests.post(url, data='[{"some": "json"}]')
        assert post4.status_code == 200

        with pytest.raises(ValueError):
            requests.post(url, files = ['bad file data'])
~~~

