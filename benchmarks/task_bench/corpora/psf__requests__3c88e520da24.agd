@x-symbol desc="class PoolError(HTTPError)" file="requests/packages/urllib3/exceptions.py" qual="PoolError" lineno=15 endline=23 refs="#requests-packages-urllib3-exceptions-py--c-locationparseerror--m-__init__" [#requests-packages-urllib3-exceptions-py--c-poolerror]
~~~
class PoolError(HTTPError):
    "Base exception for errors caused within a pool."
    def __init__(self, pool, message):
        self.pool = pool
        HTTPError.__init__(self, "%s: %s" % (pool, message))

    def __reduce__(self):
        # For pickling purposes.
        return self.__class__, (None, None)
~~~

