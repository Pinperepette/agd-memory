@x-symbol desc="def test_basicauth_with_netrc(self)" file="test_requests.py" qual="RequestsTestCase.test_basicauth_with_netrc" lineno=253 endline=279 refs="#test_requests-py--f-httpbin" [#test_requests-py--c-requeststestcase--m-test_basicauth_with_netrc]
~~~
    def test_basicauth_with_netrc(self):
        auth = ('user', 'pass')
        wrong_auth = ('wronguser', 'wrongpass')
        url = httpbin('basic-auth', 'user', 'pass')

        def get_netrc_auth_mock(url):
            return auth
        requests.sessions.get_netrc_auth = get_netrc_auth_mock

        # Should use netrc and work.
        r = requests.get(url)
        assert r.status_code == 200

        # Given auth should override and fail.
        r = requests.get(url, auth=wrong_auth)
        assert r.status_code == 401

        s = requests.session()

        # Should use netrc and work.
        r = s.get(url)
        assert r.status_code == 200

        # Given auth should override and fail.
        s.auth = wrong_auth
        r = s.get(url)
        assert r.status_code == 401
~~~

