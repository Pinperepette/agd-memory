@x-symbol desc="def __eq__(self, other)" file="requests/packages/urllib3/packages/ordered_dict.py" qual="OrderedDict.__eq__" lineno=236 endline=243 refs="#requests-packages-urllib3-packages-ordered_dict-py--c-ordereddict--m-items" [#requests-packages-urllib3-packages-ordered_dict-py--c-ordereddict--m-__eq__]
~~~
    def __eq__(self, other):
        '''od.__eq__(y) <==> od==y.  Comparison to another OD is order-sensitive
        while comparison to a regular mapping is order-insensitive.

        '''
        if isinstance(other, OrderedDict):
            return len(self)==len(other) and self.items() == other.items()
        return dict.__eq__(self, other)
~~~

