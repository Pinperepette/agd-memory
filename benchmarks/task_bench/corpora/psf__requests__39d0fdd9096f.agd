@x-symbol desc="def test_rewind_body_no_seek(self)" file="tests/test_requests.py" qual="TestRequests.test_rewind_body_no_seek" lineno=1727 endline=1745 [#tests-test_requests-py--c-testrequests--m-test_rewind_body_no_seek]
