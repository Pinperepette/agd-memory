@x-symbol desc="class MockRequest(object)" file="requests/cookies.py" qual="MockRequest" lineno=25 endline=94 refs="#requests-cookies-py--c-mockrequest--m-get_host,#requests-cookies-py--c-requestscookiejar--m-get,#requests-cookies-py--c-mockrequest--m-is_unverifiable,#requests-cookies-py--c-mockrequest--m-get_origin_req_host" [#requests-cookies-py--c-mockrequest]
