@x-symbol desc="def override_environ(**kwargs)" file="tests/utils.py" qual="override_environ" lineno=8 endline=19 [#tests-utils-py--f-override_environ]
~~~
def override_environ(**kwargs):
    save_env = dict(os.environ)
    for key, value in kwargs.items():
        if value is None:
            del os.environ[key]
        else:
            os.environ[key] = value
    try:
        yield
    finally:
        os.environ.clear()
        os.environ.update(save_env)
~~~

