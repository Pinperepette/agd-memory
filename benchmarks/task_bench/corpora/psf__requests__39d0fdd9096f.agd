@x-symbol desc="def dispatch_hook(key, hooks, hook_data, **kwargs)" file="requests/hooks.py" qual="dispatch_hook" lineno=23 endline=34 [#requests-hooks-py--f-dispatch_hook]
~~~
def dispatch_hook(key, hooks, hook_data, **kwargs):
    """Dispatches a hook dictionary on a given piece of data."""
    hooks = hooks or {}
    hooks = hooks.get(key)
    if hooks:
        if hasattr(hooks, '__call__'):
            hooks = [hooks]
        for hook in hooks:
            _hook_data = hook(hook_data, **kwargs)
            if _hook_data is not None:
                hook_data = _hook_data
    return hook_data
~~~

