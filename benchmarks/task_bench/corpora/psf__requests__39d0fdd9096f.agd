@x-symbol desc="def test_response_reason_unicode_fallback(self)" file="tests/test_requests.py" qual="TestRequests.test_response_reason_unicode_fallback" lineno=1290 endline=1300 [#tests-test_requests-py--c-testrequests--m-test_response_reason_unicode_fallback]
