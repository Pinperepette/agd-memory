    def test_rewind_body_no_seek(self):
        class BadFileObj:
            def __init__(self, data):
                self.data = data

            def tell(self):
                return 0

            def __iter__(self):
                return

        data = BadFileObj('the data')
        prep = requests.Request('GET', 'http://example.com', data=data).prepare()
        assert prep._body_position == 0

        with pytest.raises(UnrewindableBodyError) as e:
            requests.utils.rewind_body(prep)

        assert 'Unable to rewind request body' in str(e)
~~~

@x-symbol desc="def test_rewind_body_failed_seek(self)" file="tests/test_requests.py" qual="TestRequests.test_rewind_body_failed_seek" lineno=1747 endline=1768 [#tests-test_requests-py--c-testrequests--m-test_rewind_body_failed_seek]
