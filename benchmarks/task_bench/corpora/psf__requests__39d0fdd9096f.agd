            if not sock:
                break

            handler_result = self.handler(sock)

            self.handler_results.append(handler_result)
            sock.close()
~~~

@x-symbol desc="def _accept_connection(self)" file="tests/testserver/server.py" qual="Server._accept_connection" lineno=103 endline=111 [#tests-testserver-server-py--c-server--m-_accept_connection]
~~~
    def _accept_connection(self):
        try:
            ready, _, _ = select.select([self.server_sock], [], [], self.WAIT_EVENT_TIMEOUT)
            if not ready:
                return None

            return self.server_sock.accept()[0]
        except (select.error, socket.error):
            return None
~~~

