@x-symbol desc="def test_header_value_not_str(self, httpbin)" file="tests/test_requests.py" qual="TestRequests.test_header_value_not_str" lineno=1539 endline=1558 [#tests-test_requests-py--c-testrequests--m-test_header_value_not_str]
~~~
    def test_header_value_not_str(self, httpbin):
        """Ensure the header value is of type string or bytes as
        per discussion in GH issue #3386
        """
        headers_int = {'foo': 3}
        headers_dict = {'bar': {'foo': 'bar'}}
        headers_list = {'baz': ['foo', 'bar']}

        # Test for int
        with pytest.raises(InvalidHeader) as excinfo:
            r = requests.get(httpbin('get'), headers=headers_int)
        assert 'foo' in str(excinfo.value)
        # Test for dict
        with pytest.raises(InvalidHeader) as excinfo:
            r = requests.get(httpbin('get'), headers=headers_dict)
        assert 'bar' in str(excinfo.value)
        # Test for list
        with pytest.raises(InvalidHeader) as excinfo:
            r = requests.get(httpbin('get'), headers=headers_list)
        assert 'baz' in str(excinfo.value)
~~~

@x-symbol desc="def test_header_no_return_chars(self, httpbin)" file="tests/test_requests.py" qual="TestRequests.test_header_no_return_chars" lineno=1560 endline=1576 [#tests-test_requests-py--c-testrequests--m-test_header_no_return_chars]
~~~
    def test_header_no_return_chars(self, httpbin):
        """Ensure that a header containing return character sequences raise an
        exception. Otherwise, multiple headers are created from single string.
        """
        headers_ret = {'foo': 'bar\r\nbaz: qux'}
        headers_lf = {'foo': 'bar\nbaz: qux'}
        headers_cr = {'foo': 'bar\rbaz: qux'}

        # Test for newline
        with pytest.raises(InvalidHeader):
            r = requests.get(httpbin('get'), headers=headers_ret)
        # Test for line feed
        with pytest.raises(InvalidHeader):
            r = requests.get(httpbin('get'), headers=headers_lf)
        # Test for carriage return
        with pytest.raises(InvalidHeader):
            r = requests.get(httpbin('get'), headers=headers_cr)
~~~

@x-symbol desc="def test_header_no_leading_space(self, httpbin)" file="tests/test_requests.py" qual="TestRequests.test_header_no_leading_space" lineno=1578 endline=1590 [#tests-test_requests-py--c-testrequests--m-test_header_no_leading_space]
