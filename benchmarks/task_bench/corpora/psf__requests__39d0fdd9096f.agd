@x-symbol desc="def test_proxy_error_on_bad_url(self, httpbin, httpbin_secure)" file="tests/test_requests.py" qual="TestRequests.test_proxy_error_on_bad_url" lineno=544 endline=555 [#tests-test_requests-py--c-testrequests--m-test_proxy_error_on_bad_url]
~~~
    def test_proxy_error_on_bad_url(self, httpbin, httpbin_secure):
        with pytest.raises(InvalidProxyURL):
            requests.get(httpbin_secure(), proxies={'https': 'http:/badproxyurl:3128'})

        with pytest.raises(InvalidProxyURL):
            requests.get(httpbin(), proxies={'http': 'http://:8080'})

        with pytest.raises(InvalidProxyURL):
            requests.get(httpbin_secure(), proxies={'https': 'https://'})

        with pytest.raises(InvalidProxyURL):
            requests.get(httpbin(), proxies={'http': 'http:///example.com:8080'})
~~~

