@x-symbol desc="def test_session_hooks_are_used_with_no_request_hooks(self, httpbin)" file="tests/test_requests.py" qual="TestRequests.test_session_hooks_are_used_with_no_request_hooks" lineno=1004 endline=1011 [#tests-test_requests-py--c-testrequests--m-test_session_hooks_are_used_with_no_request_hooks]
~~~
    def test_session_hooks_are_used_with_no_request_hooks(self, httpbin):
        hook = lambda x, *args, **kwargs: x
        s = requests.Session()
        s.hooks['response'].append(hook)
        r = requests.Request('GET', httpbin())
        prep = s.prepare_request(r)
        assert prep.hooks['response'] != []
        assert prep.hooks['response'] == [hook]
~~~

@x-symbol desc="def test_session_hooks_are_overridden_by_request_hooks(self, httpbin)" file="tests/test_requests.py" qual="TestRequests.test_session_hooks_are_overridden_by_request_hooks" lineno=1013 endline=1021 [#tests-test_requests-py--c-testrequests--m-test_session_hooks_are_overridden_by_request_hooks]
~~~
    def test_session_hooks_are_overridden_by_request_hooks(self, httpbin):
        hook1 = lambda x, *args, **kwargs: x
        hook2 = lambda x, *args, **kwargs: x
        assert hook1 is not hook2
        s = requests.Session()
        s.hooks['response'].append(hook2)
        r = requests.Request('GET', httpbin(), hooks={'response': [hook1]})
        prep = s.prepare_request(r)
        assert prep.hooks['response'] == [hook1]
~~~

@x-symbol desc="def test_prepared_request_hook(self, httpbin)" file="tests/test_requests.py" qual="TestRequests.test_prepared_request_hook" lineno=1023 endline=1035 refs="#tests-test_requests-py--c-redirectsession--m-send" [#tests-test_requests-py--c-testrequests--m-test_prepared_request_hook]
~~~
    def test_prepared_request_hook(self, httpbin):
        def hook(resp, **kwargs):
            resp.hook_working = True
            return resp

        req = requests.Request('GET', httpbin(), hooks={'response': hook})
        prep = req.prepare()

        s = requests.Session()
        s.proxies = getproxies()
        resp = s.send(prep)

        assert hasattr(resp, 'hook_working')
~~~

@x-symbol desc="def test_prepared_from_session(self, httpbin)" file="tests/test_requests.py" qual="TestRequests.test_prepared_from_session" lineno=1037 endline=1053 refs="#tests-test_requests-py--c-redirectsession--m-send" [#tests-test_requests-py--c-testrequests--m-test_prepared_from_session]
~~~
    def test_prepared_from_session(self, httpbin):
        class DummyAuth(requests.auth.AuthBase):
            def __call__(self, r):
                r.headers['Dummy-Auth-Test'] = 'dummy-auth-test-ok'
                return r

        req = requests.Request('GET', httpbin('headers'))
        assert not req.auth

        s = requests.Session()
        s.auth = DummyAuth()

        prep = s.prepare_request(req)
        resp = s.send(prep)

        assert resp.json()['headers'][
            'Dummy-Auth-Test'] == 'dummy-auth-test-ok'
~~~

