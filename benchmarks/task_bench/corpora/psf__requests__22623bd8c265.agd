@x-symbol desc="def extract_cookies_to_jar(jar, request, response)" file="requests/cookies.py" qual="extract_cookies_to_jar" lineno=94 endline=105 refs="#requests-cookies-py--c-mockrequest,#requests-cookies-py--c-mockresponse" [#requests-cookies-py--f-extract_cookies_to_jar]
~~~
def extract_cookies_to_jar(jar, request, response):
    """Extract the cookies from the response into a CookieJar.

    :param jar: cookielib.CookieJar (not necessarily a RequestsCookieJar)
    :param request: our own requests.Request object
    :param response: urllib3.HTTPResponse object
    """
    # the _original_response field is the wrapped httplib.HTTPResponse object,
    req = MockRequest(request)
    # pull out the HTTPMessage with the headers and put it in the mock:
    res = MockResponse(response._original_response.msg)
    jar.extract_cookies(res, req)
~~~

@x-symbol desc="def get_cookie_header(jar, request)" file="requests/cookies.py" qual="get_cookie_header" lineno=108 endline=112 refs="#requests-cookies-py--c-mockrequest,#requests-cookies-py--c-requestscookiejar--m-get,#requests-cookies-py--c-mockrequest--m-get_new_headers" [#requests-cookies-py--f-get_cookie_header]
~~~
def get_cookie_header(jar, request):
    """Produce an appropriate Cookie header string to be sent with `request`, or None."""
    r = MockRequest(request)
    jar.add_cookie_header(r)
    return r.get_new_headers().get('Cookie')
~~~

@x-symbol desc="def remove_cookie_by_name(cookiejar, name, domain=None, path=None)" file="requests/cookies.py" qual="remove_cookie_by_name" lineno=115 endline=128 [#requests-cookies-py--f-remove_cookie_by_name]
~~~
def remove_cookie_by_name(cookiejar, name, domain=None, path=None):
    """Unsets a cookie by name, by default over all domains and paths.

    Wraps CookieJar.clear(), is O(n).
    """
    clearables = []
    for cookie in cookiejar:
        if cookie.name == name:
            if domain is None or domain == cookie.domain:
                if path is None or path == cookie.path:
                    clearables.append((cookie.domain, cookie.path, cookie.name))

    for domain, path, name in clearables:
        cookiejar.clear(domain, path, name)
~~~

