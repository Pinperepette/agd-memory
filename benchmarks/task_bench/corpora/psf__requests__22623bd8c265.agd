@x-symbol desc="class ProxyManager(RequestMethods)" file="requests/packages/urllib3/poolmanager.py" qual="ProxyManager" lineno=147 endline=167 refs="#requests-packages-urllib3-poolmanager-py--c-proxymanager--m-_set_proxy_headers,#requests-packages-urllib3-poolmanager-py--c-proxymanager--m-urlopen" [#requests-packages-urllib3-poolmanager-py--c-proxymanager]
~~~
class ProxyManager(RequestMethods):
    """
    Given a ConnectionPool to a proxy, the ProxyManager's ``urlopen`` method
    will make requests to any url through the defined proxy.
    """

    def __init__(self, proxy_pool):
        self.proxy_pool = proxy_pool

    def _set_proxy_headers(self, headers=None):
        headers_ = {'Accept': '*/*'}
        if headers:
            headers_.update(headers)

        return headers_

    def urlopen(self, method, url, **kw):
        "Same as HTTP(S)ConnectionPool.urlopen, ``url`` must be absolute."
        kw['assert_same_host'] = False
        kw['headers'] = self._set_proxy_headers(kw.get('headers'))
        return self.proxy_pool.urlopen(method, url, **kw)
~~~

