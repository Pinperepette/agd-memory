@x-symbol desc="class MovedAttribute(_LazyDescr)" file="requests/packages/urllib3/packages/six.py" qual="MovedAttribute" lineno=106 endline=128 refs="#requests-packages-urllib3-packages-six-py--c-movedattribute--m-__init__,#requests-packages-urllib3-packages-six-py--f-_import_module" [#requests-packages-urllib3-packages-six-py--c-movedattribute]
~~~
class MovedAttribute(_LazyDescr):

    def __init__(self, name, old_mod, new_mod, old_attr=None, new_attr=None):
        super(MovedAttribute, self).__init__(name)
        if PY3:
            if new_mod is None:
                new_mod = name
            self.mod = new_mod
            if new_attr is None:
                if old_attr is None:
                    new_attr = name
                else:
                    new_attr = old_attr
            self.attr = new_attr
        else:
            self.mod = old_mod
            if old_attr is None:
                old_attr = name
            self.attr = old_attr

    def _resolve(self):
        module = _import_module(self.mod)
        return getattr(module, self.attr)
~~~

