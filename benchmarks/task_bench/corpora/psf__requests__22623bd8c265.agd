@x-symbol desc="def test_custom_content_type(self)" file="test_requests.py" qual="RequestsTestCase.test_custom_content_type" lineno=255 endline=262 refs="#test_requests-py--f-httpbin" [#test_requests-py--c-requeststestcase--m-test_custom_content_type]
~~~
    def test_custom_content_type(self):
        r = requests.post(httpbin('post'),
                          data={'stuff': json.dumps({'a': 123})},
                          files={'file1': ('test_requests.py', open(__file__, 'rb')),
                                 'file2': ('test_requests', open(__file__, 'rb'),
                                           'text/py-content-type')})
        self.assertEqual(r.status_code, 200)
        self.assertTrue(b"text/py-content-type" in r.request.body)
~~~

@x-symbol desc="def test_prepared_request_hook(self)" file="test_requests.py" qual="RequestsTestCase.test_prepared_request_hook" lineno=264 endline=275 [#test_requests-py--c-requeststestcase--m-test_prepared_request_hook]
~~~
    def test_prepared_request_hook(self):
        def hook(resp):
            resp.hook_working = True
            return resp

        req = requests.Request('GET', HTTPBIN, hooks={'response': hook})
        prep = req.prepare()

        s = requests.Session()
        resp = s.send(prep)

        self.assertTrue(hasattr(resp, 'hook_working'))
~~~

