@h2 requests/auth.py [#file--requests-auth-py]

@x-symbol desc="def _basic_auth_str(username, password)" file="requests/auth.py" qual="_basic_auth_str" lineno=27 endline=30 [#requests-auth-py--f-_basic_auth_str]
~~~
def _basic_auth_str(username, password):
    """Returns a Basic Auth string."""

    return 'Basic ' + b64encode(('%s:%s' % (username, password)).encode('latin1')).strip().decode('latin1')
~~~

