@x-symbol desc="def __repr__(self, _repr_running={})" file="requests/packages/urllib3/packages/ordered_dict.py" qual="OrderedDict.__repr__" lineno=198 endline=209 refs="#requests-packages-urllib3-packages-ordered_dict-py--c-ordereddict--m-items" [#requests-packages-urllib3-packages-ordered_dict-py--c-ordereddict--m-__repr__]
~~~
    def __repr__(self, _repr_running={}):
        'od.__repr__() <==> repr(od)'
        call_key = id(self), _get_ident()
        if call_key in _repr_running:
            return '...'
        _repr_running[call_key] = 1
        try:
            if not self:
                return '%s()' % (self.__class__.__name__,)
            return '%s(%r)' % (self.__class__.__name__, self.items())
        finally:
            del _repr_running[call_key]
~~~

@x-symbol desc="def __reduce__(self)" file="requests/packages/urllib3/packages/ordered_dict.py" qual="OrderedDict.__reduce__" lineno=211 endline=219 refs="#requests-packages-urllib3-packages-ordered_dict-py--c-ordereddict--m-copy,#requests-packages-urllib3-packages-ordered_dict-py--c-ordereddict,#requests-packages-urllib3-packages-ordered_dict-py--c-ordereddict--m-pop" [#requests-packages-urllib3-packages-ordered_dict-py--c-ordereddict--m-__reduce__]
~~~
    def __reduce__(self):
        'Return state information for pickling'
        items = [[k, self[k]] for k in self]
        inst_dict = vars(self).copy()
        for k in vars(OrderedDict()):
            inst_dict.pop(k, None)
        if inst_dict:
            return (self.__class__, (items,), inst_dict)
        return self.__class__, (items,)
~~~

