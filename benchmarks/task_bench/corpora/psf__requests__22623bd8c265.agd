@x-symbol desc="def __reversed__(self)" file="requests/packages/urllib3/packages/ordered_dict.py" qual="OrderedDict.__reversed__" lineno=72 endline=78 [#requests-packages-urllib3-packages-ordered_dict-py--c-ordereddict--m-__reversed__]
~~~
    def __reversed__(self):
        'od.__reversed__() <==> reversed(od)'
        root = self.__root
        curr = root[0]
        while curr is not root:
            yield curr[2]
            curr = curr[0]
