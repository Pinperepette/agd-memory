def decode_gzip(data):
    gzipper = gzip.GzipFile(fileobj=BytesIO(data))
    return gzipper.read()
~~~

@x-symbol desc="def decode_deflate(data)" file="requests/packages/urllib3/response.py" qual="decode_deflate" lineno=25 endline=29 [#requests-packages-urllib3-response-py--f-decode_deflate]
~~~
def decode_deflate(data):
    try:
        return zlib.decompress(data)
    except zlib.error:
        return zlib.decompress(data, -zlib.MAX_WBITS)
~~~

