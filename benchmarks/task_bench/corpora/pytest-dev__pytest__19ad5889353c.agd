@x-symbol desc="def item_capture(self, when: str, item: Item)" file="src/_pytest/capture.py" qual="CaptureManager.item_capture" lineno=708 endline=719 refs="#src-_pytest-capture-py--c-capturemanager--m-resume_global_capture,#src-_pytest-capture-py--c-capturemanager--m-activate_fixture,#src-_pytest-capture-py--c-capturemanager--m-read_global_capture,#src-_pytest-capture-py--c-capturemanager--m-deactivate_fixture,#src-_pytest-capture-py--c-capturemanager--m-suspend_global_capture" [#src-_pytest-capture-py--c-capturemanager--m-item_capture]
~~~
    def item_capture(self, when: str, item: Item) -> Generator[None, None, None]:
        self.resume_global_capture()
        self.activate_fixture()
        try:
            yield
        finally:
            self.deactivate_fixture()
            self.suspend_global_capture(in_=False)

        out, err = self.read_global_capture()
        item.add_report_section(when, "stdout", out)
        item.add_report_section(when, "stderr", err)
~~~

@x-symbol desc="def pytest_make_collect_report(self, collector: Collector)" file="src/_pytest/capture.py" qual="CaptureManager.pytest_make_collect_report" lineno=724 endline=736 refs="#src-_pytest-capture-py--c-capturemanager--m-resume_global_capture,#src-_pytest-capture-py--c-capturemanager--m-suspend_global_capture,#src-_pytest-capture-py--c-capturemanager--m-read_global_capture" [#src-_pytest-capture-py--c-capturemanager--m-pytest_make_collect_report]
~~~
    def pytest_make_collect_report(self, collector: Collector):
        if isinstance(collector, pytest.File):
            self.resume_global_capture()
            outcome = yield
            self.suspend_global_capture()
            out, err = self.read_global_capture()
            rep = outcome.get_result()
            if out:
                rep.sections.append(("Captured stdout", out))
            if err:
                rep.sections.append(("Captured stderr", err))
        else:
            yield
~~~

