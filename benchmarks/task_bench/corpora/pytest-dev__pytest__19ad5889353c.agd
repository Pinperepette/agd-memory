@x-symbol desc="def test_funcarg(self, testdir, scope, ok, error)" file="testing/python/fixtures.py" qual="TestRequestScopeAccess.test_funcarg" lineno=3049 endline=3068 [#testing-python-fixtures-py--c-testrequestscopeaccess--m-test_funcarg]
~~~
    def test_funcarg(self, testdir, scope, ok, error):
        testdir.makepyfile(
            """
            import pytest
            @pytest.fixture(scope=%r)
            def arg(request):
                for x in %r:
                    assert hasattr(request, x)
                for x in %r:
                    pytest.raises(AttributeError, lambda:
                        getattr(request, x))
                assert request.session
                assert request.config
            def test_func(arg):
                pass
        """
            % (scope, ok.split(), error.split())
        )
        reprec = testdir.inline_run()
        reprec.assertoutcome(passed=1)
~~~

