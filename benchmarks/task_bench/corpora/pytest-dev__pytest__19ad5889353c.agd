@x-symbol desc="def test_warning_on_unwrap_of_broken_object(stop: Optional[Callable[[object], object]])" file="testing/test_doctest.py" qual="test_warning_on_unwrap_of_broken_object" lineno=1482 endline=1494 refs="#testing-test_doctest-py--c-broken" [#testing-test_doctest-py--f-test_warning_on_unwrap_of_broken_object]
~~~
def test_warning_on_unwrap_of_broken_object(
    stop: Optional[Callable[[object], object]]
) -> None:
    bad_instance = Broken()
    assert inspect.unwrap.__module__ == "inspect"
    with _patch_unwrap_mock_aware():
        assert inspect.unwrap.__module__ != "inspect"
        with pytest.warns(
            pytest.PytestWarning, match="^Got KeyError.* when unwrapping"
        ):
            with pytest.raises(KeyError):
                inspect.unwrap(bad_instance, stop=stop)  # type: ignore[arg-type] # noqa: F821
    assert inspect.unwrap.__module__ == "inspect"
~~~

