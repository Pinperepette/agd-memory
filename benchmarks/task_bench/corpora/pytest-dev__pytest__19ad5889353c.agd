@x-symbol desc="def test_pdb_can_be_rewritten(testdir)" file="testing/acceptance_test.py" qual="test_pdb_can_be_rewritten" lineno=1260 endline=1294 [#testing-acceptance_test-py--f-test_pdb_can_be_rewritten]
~~~
def test_pdb_can_be_rewritten(testdir):
    testdir.makepyfile(
        **{
            "conftest.py": """
                import pytest
                pytest.register_assert_rewrite("pdb")
                """,
            "__init__.py": "",
            "pdb.py": """
                def check():
                    assert 1 == 2
                """,
            "test_pdb.py": """
                def test():
                    import pdb
                    assert pdb.check()
                """,
        }
    )
    # Disable debugging plugin itself to avoid:
    # > INTERNALERROR> AttributeError: module 'pdb' has no attribute 'set_trace'
    result = testdir.runpytest_subprocess("-p", "no:debugging", "-vv")
    result.stdout.fnmatch_lines(
        [
            "    def check():",
            ">       assert 1 == 2",
            "E       assert 1 == 2",
            "E         +1",
            "E         -2",
            "",
            "pdb.py:2: AssertionError",
            "*= 1 failed in *",
        ]
    )
    assert result.ret == 1
~~~

@x-symbol desc="def test_tee_stdio_captures_and_live_prints(testdir)" file="testing/acceptance_test.py" qual="test_tee_stdio_captures_and_live_prints" lineno=1297 endline=1322 [#testing-acceptance_test-py--f-test_tee_stdio_captures_and_live_prints]
~~~
def test_tee_stdio_captures_and_live_prints(testdir):
    testpath = testdir.makepyfile(
        """
        import sys
        def test_simple():
            print ("@this is stdout@")
            print ("@this is stderr@", file=sys.stderr)
    """
    )
    result = testdir.runpytest_subprocess(
        testpath,
        "--capture=tee-sys",
        "--junitxml=output.xml",
        "-o",
        "junit_logging=all",
    )

    # ensure stdout/stderr were 'live printed'
    result.stdout.fnmatch_lines(["*@this is stdout@*"])
    result.stderr.fnmatch_lines(["*@this is stderr@*"])

    # now ensure the output is in the junitxml
    with open(os.path.join(testdir.tmpdir.strpath, "output.xml")) as f:
        fullXml = f.read()
    assert "@this is stdout@\n" in fullXml
    assert "@this is stderr@\n" in fullXml
~~~

@x-symbol desc="def test_no_brokenpipeerror_message(testdir: Testdir)" file="testing/acceptance_test.py" qual="test_no_brokenpipeerror_message" lineno=1329 endline=1340 [#testing-acceptance_test-py--f-test_no_brokenpipeerror_message]
~~~
def test_no_brokenpipeerror_message(testdir: Testdir) -> None:
    """Ensure that the broken pipe error message is supressed.

    In some Python versions, it reaches sys.unraisablehook, in others
    a BrokenPipeError exception is propagated, but either way it prints
    to stderr on shutdown, so checking nothing is printed is enough.
    """
    popen = testdir.popen((*testdir._getpytestargs(), "--help"))
    popen.stdout.close()
    ret = popen.wait()
    assert popen.stderr.read() == b""
    assert ret == 1
~~~

