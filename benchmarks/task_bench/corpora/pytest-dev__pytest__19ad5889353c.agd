@x-symbol desc="def test_pdb_print_captured_stdout_and_stderr(self, testdir)" file="testing/test_debugging.py" qual="TestPDB.test_pdb_print_captured_stdout_and_stderr" lineno=200 endline=227 refs="#testing-test_debugging-py--c-testpdb--m-flush" [#testing-test_debugging-py--c-testpdb--m-test_pdb_print_captured_stdout_and_stderr]
~~~
    def test_pdb_print_captured_stdout_and_stderr(self, testdir):
        p1 = testdir.makepyfile(
            """
            def test_1():
                import sys
                sys.stderr.write("get\\x20rekt")
                print("get\\x20rekt")
                assert False

            def test_not_called_due_to_quit():
                pass
        """
        )
        child = testdir.spawn_pytest("--pdb %s" % p1)
        child.expect("captured stdout")
        child.expect("get rekt")
        child.expect("captured stderr")
        child.expect("get rekt")
        child.expect("traceback")
        child.expect("def test_1")
        child.expect("Pdb")
        child.sendeof()
        rest = child.read().decode("utf8")
        assert "Exit: Quitting debugger" in rest
        assert "= 1 failed in" in rest
        assert "def test_1" not in rest
        assert "get rekt" not in rest
        self.flush(child)
~~~

