@x-symbol desc="def test_toterminal_long_incomplete_source(self, importasmod, tmpdir, tw_mock)" file="testing/code/test_excinfo.py" qual="TestFormattedExcinfo.test_toterminal_long_incomplete_source" lineno=983 endline=1011 refs="#testing-code-test_excinfo-py--c-testformattedexcinfo--m-importasmod" [#testing-code-test_excinfo-py--c-testformattedexcinfo--m-test_toterminal_long_incomplete_source]
