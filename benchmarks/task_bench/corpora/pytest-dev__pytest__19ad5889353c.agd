@x-symbol desc="def test_error_diff(code, expected, testdir)" file="testing/test_error_diffs.py" qual="test_error_diff" lineno=269 endline=274 [#testing-test_error_diffs-py--f-test_error_diff]
~~~
def test_error_diff(code, expected, testdir):
    expected = [line.lstrip() for line in expected.splitlines()]
    p = testdir.makepyfile(code)
    result = testdir.runpytest(p, "-vv")
    result.stdout.fnmatch_lines(expected)
    assert result.ret == 1
