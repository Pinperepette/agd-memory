@x-symbol desc="def test_xfail_captures_output_once(self, testdir, junit_logging, run_and_parse)" file="testing/test_junitxml.py" qual="TestPython.test_xfail_captures_output_once" lineno=628 endline=652 refs="#testing-test_junitxml-py--f-run_and_parse,#testing-test_junitxml-py--c-domnode--m-find_first_by_tag,#testing-test_junitxml-py--c-domnode--m-find_by_tag" [#testing-test_junitxml-py--c-testpython--m-test_xfail_captures_output_once]
~~~
    def test_xfail_captures_output_once(self, testdir, junit_logging, run_and_parse):
        testdir.makepyfile(
            """
            import sys
            import pytest

            @pytest.mark.xfail()
            def test_fail():
                sys.stdout.write('XFAIL This is stdout')
                sys.stderr.write('XFAIL This is stderr')
                assert 0
        """
        )
        result, dom = run_and_parse("-o", "junit_logging=%s" % junit_logging)
        node = dom.find_first_by_tag("testsuite")
        tnode = node.find_first_by_tag("testcase")
        if junit_logging in ["system-err", "out-err", "all"]:
            assert len(tnode.find_by_tag("system-err")) == 1
        else:
            assert len(tnode.find_by_tag("system-err")) == 0

        if junit_logging in ["log", "system-out", "out-err", "all"]:
            assert len(tnode.find_by_tag("system-out")) == 1
        else:
            assert len(tnode.find_by_tag("system-out")) == 0
~~~

