@x-symbol desc="def _check_initialpaths_for_relpath(session, fspath)" file="src/_pytest/nodes.py" qual="_check_initialpaths_for_relpath" lineno=491 endline=494 [#src-_pytest-nodes-py--f-_check_initialpaths_for_relpath]
~~~
def _check_initialpaths_for_relpath(session, fspath):
    for initial_path in session._initialpaths:
        if fspath.common(initial_path) == initial_path:
            return fspath.relto(initial_path)
~~~

@x-symbol desc="class FSHookProxy" file="src/_pytest/nodes.py" qual="FSHookProxy" lineno=497 endline=505 [#src-_pytest-nodes-py--c-fshookproxy]
~~~
class FSHookProxy:
    def __init__(self, pm: PytestPluginManager, remove_mods) -> None:
        self.pm = pm
        self.remove_mods = remove_mods

    def __getattr__(self, name: str):
        x = self.pm.subset_hook_caller(name, remove_plugins=self.remove_mods)
        self.__dict__[name] = x
        return x
~~~

