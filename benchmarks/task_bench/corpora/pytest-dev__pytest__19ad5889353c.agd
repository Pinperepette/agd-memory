@x-symbol desc="def pytest_fixture_setup(fixturedef: FixtureDef, request: SubRequest)" file="src/_pytest/setupplan.py" qual="pytest_fixture_setup" lineno=24 endline=32 [#src-_pytest-setupplan-py--f-pytest_fixture_setup]
~~~
def pytest_fixture_setup(
    fixturedef: FixtureDef, request: SubRequest
) -> Optional[object]:
    # Will return a dummy fixture if the setuponly option is provided.
    if request.config.option.setupplan:
        my_cache_key = fixturedef.cache_key(request)
        fixturedef.cached_result = (None, my_cache_key, None)
        return fixturedef.cached_result
    return None
~~~

