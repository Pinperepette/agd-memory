@x-symbol desc="def _mk_tmp(request: FixtureRequest, factory: TempPathFactory)" file="src/_pytest/tmpdir.py" qual="_mk_tmp" lineno=169 endline=174 refs="#src-_pytest-tmpdir-py--c-tempdirfactory--m-mktemp" [#src-_pytest-tmpdir-py--f-_mk_tmp]
~~~
def _mk_tmp(request: FixtureRequest, factory: TempPathFactory) -> Path:
    name = request.node.name
    name = re.sub(r"[\W]", "_", name)
    MAXVAL = 30
    name = name[:MAXVAL]
    return factory.mktemp(name, numbered=True)
~~~

@x-symbol desc="def tmpdir(tmp_path)" file="src/_pytest/tmpdir.py" qual="tmpdir" lineno=178 endline=187 [#src-_pytest-tmpdir-py--f-tmpdir]
~~~
def tmpdir(tmp_path):
    """Return a temporary directory path object
    which is unique to each test function invocation,
    created as a sub directory of the base temporary
    directory.  The returned object is a `py.path.local`_
    path object.

    .. _`py.path.local`: https://py.readthedocs.io/en/latest/path.html
    """
    return py.path.local(tmp_path)
~~~

@x-symbol desc="def tmp_path(request: FixtureRequest, tmp_path_factory: TempPathFactory)" file="src/_pytest/tmpdir.py" qual="tmp_path" lineno=191 endline=203 refs="#src-_pytest-tmpdir-py--f-_mk_tmp" [#src-_pytest-tmpdir-py--f-tmp_path]
~~~
def tmp_path(request: FixtureRequest, tmp_path_factory: TempPathFactory) -> Path:
    """Return a temporary directory path object
    which is unique to each test function invocation,
    created as a sub directory of the base temporary
    directory.  The returned object is a :class:`pathlib.Path`
    object.

    .. note::

        in python < 3.6 this is a pathlib2.Path
    """

    return _mk_tmp(request, tmp_path_factory)
~~~

