~~~
def pytest_collect_file(parent, path):
    if path.ext == ".yaml" and path.basename.startswith("test"):
        return YamlFile.from_parent(parent, fspath=path)
~~~

@x-symbol desc="class YamlFile(pytest.File)" file="doc/en/example/nonpython/conftest.py" qual="YamlFile" lineno=10 endline=16 [#doc-en-example-nonpython-conftest-py--c-yamlfile]
~~~
class YamlFile(pytest.File):
    def collect(self):
        import yaml  # we need a yaml parser, e.g. PyYAML

        raw = yaml.safe_load(self.fspath.open())
        for name, spec in sorted(raw.items()):
            yield YamlItem.from_parent(self, name=name, spec=spec)
~~~

@x-symbol desc="def collect(self)" file="doc/en/example/nonpython/conftest.py" qual="YamlFile.collect" lineno=11 endline=16 [#doc-en-example-nonpython-conftest-py--c-yamlfile--m-collect]
~~~
    def collect(self):
        import yaml  # we need a yaml parser, e.g. PyYAML

        raw = yaml.safe_load(self.fspath.open())
        for name, spec in sorted(raw.items()):
            yield YamlItem.from_parent(self, name=name, spec=spec)
~~~

@x-symbol desc="class YamlItem(pytest.Item)" file="doc/en/example/nonpython/conftest.py" qual="YamlItem" lineno=19 endline=42 refs="#doc-en-example-nonpython-conftest-py--c-yamlitem--m-__init__,#doc-en-example-nonpython-conftest-py--c-yamlexception" [#doc-en-example-nonpython-conftest-py--c-yamlitem]
~~~
class YamlItem(pytest.Item):
    def __init__(self, name, parent, spec):
        super().__init__(name, parent)
        self.spec = spec

    def runtest(self):
        for name, value in sorted(self.spec.items()):
            # some custom test execution (dumb example follows)
            if name != value:
                raise YamlException(self, name, value)

    def repr_failure(self, excinfo):
        """ called when self.runtest() raises an exception. """
        if isinstance(excinfo.value, YamlException):
            return "\n".join(
                [
                    "usecase execution failed",
                    "   spec failed: {1!r}: {2!r}".format(*excinfo.value.args),
                    "   no further details known at this point.",
                ]
            )

    def reportinfo(self):
        return self.fspath, 0, "usecase: {}".format(self.name)
~~~

