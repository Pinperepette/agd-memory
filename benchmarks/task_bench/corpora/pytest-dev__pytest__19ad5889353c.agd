@x-symbol desc="def test_encodedfile_writelines(tmpfile: BinaryIO)" file="testing/test_capture.py" qual="test_encodedfile_writelines" lineno=1536 endline=1546 [#testing-test_capture-py--f-test_encodedfile_writelines]
~~~
def test_encodedfile_writelines(tmpfile: BinaryIO) -> None:
    ef = capture.EncodedFile(tmpfile, encoding="utf-8")
    with pytest.raises(TypeError):
        ef.writelines([b"line1", b"line2"])
    assert ef.writelines(["line3", "line4"]) is None  # type: ignore[func-returns-value]  # noqa: F821
    ef.flush()
    tmpfile.seek(0)
    assert tmpfile.read() == b"line3line4"
    tmpfile.close()
    with pytest.raises(ValueError):
        ef.read()
~~~

