@x-symbol desc="def safeformat(obj: object)" file="src/_pytest/_io/saferepr.py" qual="safeformat" lineno=67 endline=75 refs="#src-_pytest-_io-saferepr-py--f-_format_repr_exception" [#src-_pytest-_io-saferepr-py--f-safeformat]
~~~
def safeformat(obj: object) -> str:
    """return a pretty printed string for the given object.
    Failing __repr__ functions of user instances will be represented
    with a short exception info.
    """
    try:
        return pprint.pformat(obj)
    except Exception as exc:
        return _format_repr_exception(exc, obj)
~~~

@x-symbol desc="def saferepr(obj: object, maxsize: int=240)" file="src/_pytest/_io/saferepr.py" qual="saferepr" lineno=78 endline=85 refs="#src-_pytest-_io-saferepr-py--c-saferepr--m-repr,#src-_pytest-_io-saferepr-py--c-saferepr" [#src-_pytest-_io-saferepr-py--f-saferepr]
~~~
def saferepr(obj: object, maxsize: int = 240) -> str:
    """return a size-limited safe repr-string for the given object.
    Failing __repr__ functions of user instances will be represented
    with a short exception info and 'saferepr' generally takes
    care to never raise exceptions itself.  This function is a wrapper
    around the Repr/reprlib functionality of the standard 2.6 lib.
    """
    return SafeRepr(maxsize).repr(obj)
~~~

@x-symbol desc="class AlwaysDispatchingPrettyPrinter(pprint.PrettyPrinter)" file="src/_pytest/_io/saferepr.py" qual="AlwaysDispatchingPrettyPrinter" lineno=88 endline=113 refs="#src-_pytest-_io-saferepr-py--c-alwaysdispatchingprettyprinter--m-_format" [#src-_pytest-_io-saferepr-py--c-alwaysdispatchingprettyprinter]
~~~
class AlwaysDispatchingPrettyPrinter(pprint.PrettyPrinter):
    """PrettyPrinter that always dispatches (regardless of width)."""

    def _format(
        self,
        object: object,
        stream: IO[str],
        indent: int,
        allowance: int,
        context: Dict[int, Any],
        level: int,
    ) -> None:
        # Type ignored because _dispatch is private.
        p = self._dispatch.get(type(object).__repr__, None)  # type: ignore[attr-defined] # noqa: F821

        objid = id(object)
        if objid in context or p is None:
            # Type ignored because _format is private.
            super()._format(  # type: ignore[misc] # noqa: F821
                object, stream, indent, allowance, context, level,
            )
            return

        context[objid] = 1
        p(self, object, stream, indent, allowance, context, level + 1)
        del context[objid]
~~~

