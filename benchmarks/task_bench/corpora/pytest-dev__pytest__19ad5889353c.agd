@x-symbol desc="def test_parametrize_with_mark(self, testdir)" file="testing/python/collect.py" qual="TestFunction.test_parametrize_with_mark" lineno=479 endline=498 [#testing-python-collect-py--c-testfunction--m-test_parametrize_with_mark]
~~~
    def test_parametrize_with_mark(self, testdir):
        items = testdir.getitems(
            """
            import pytest
            @pytest.mark.foo
            @pytest.mark.parametrize('arg', [
                1,
                pytest.param(2, marks=[pytest.mark.baz, pytest.mark.bar])
            ])
            def test_function(arg):
                pass
        """
        )
        keywords = [item.keywords for item in items]
        assert (
            "foo" in keywords[0]
            and "bar" not in keywords[0]
            and "baz" not in keywords[0]
        )
        assert "foo" in keywords[1] and "bar" in keywords[1] and "baz" in keywords[1]
~~~

