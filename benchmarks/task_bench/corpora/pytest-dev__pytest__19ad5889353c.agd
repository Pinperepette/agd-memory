@x-symbol desc="def test_search_conftest_up_to_inifile(testdir, confcutdir, passed, error)" file="testing/test_conftest.py" qual="test_search_conftest_up_to_inifile" lineno=532 endline=577 [#testing-test_conftest-py--f-test_search_conftest_up_to_inifile]
~~~
def test_search_conftest_up_to_inifile(testdir, confcutdir, passed, error):
    """Test that conftest files are detected only up to an ini file, unless
    an explicit --confcutdir option is given.
    """
    root = testdir.tmpdir
    src = root.join("src").ensure(dir=1)
    src.join("pytest.ini").write("[pytest]")
    src.join("conftest.py").write(
        textwrap.dedent(
            """\
            import pytest
            @pytest.fixture
            def fix1(): pass
            """
        )
    )
    src.join("test_foo.py").write(
        textwrap.dedent(
            """\
            def test_1(fix1):
                pass
            def test_2(out_of_reach):
                pass
            """
        )
    )
    root.join("conftest.py").write(
        textwrap.dedent(
            """\
            import pytest
            @pytest.fixture
            def out_of_reach(): pass
            """
        )
    )

    args = [str(src)]
    if confcutdir:
        args = ["--confcutdir=%s" % root.join(confcutdir)]
    result = testdir.runpytest(*args)
    match = ""
    if passed:
        match += "*%d passed*" % passed
    if error:
        match += "*%d error*" % error
    result.stdout.fnmatch_lines(match)
~~~

