@x-symbol desc="def test_full_output_truncated(self, monkeypatch, testdir)" file="testing/test_assertion.py" qual="TestTruncateExplanation.test_full_output_truncated" lineno=1037 endline=1072 [#testing-test_assertion-py--c-testtruncateexplanation--m-test_full_output_truncated]
