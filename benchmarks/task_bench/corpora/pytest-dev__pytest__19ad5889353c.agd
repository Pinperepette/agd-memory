@x-symbol desc="class ApproxSequencelike(ApproxBase)" file="src/_pytest/python_api.py" qual="ApproxSequencelike" lineno=182 endline=213 refs="#src-_pytest-python_api-py--c-approxscalar--m-__eq__,#src-_pytest-python_api-py--c-approxbase--m-_approx_scalar,#src-_pytest-python_api-py--f-_non_numeric_type_error" [#src-_pytest-python_api-py--c-approxsequencelike]
~~~
class ApproxSequencelike(ApproxBase):
    """
    Perform approximate comparisons where the expected value is a sequence of
    numbers.
    """

    def __repr__(self):
        seq_type = type(self.expected)
        if seq_type not in (tuple, list, set):
            seq_type = list
        return "approx({!r})".format(
            seq_type(self._approx_scalar(x) for x in self.expected)
        )

    def __eq__(self, actual):
        if len(actual) != len(self.expected):
            return False
        return ApproxBase.__eq__(self, actual)

    def _yield_comparisons(self, actual):
        return zip(actual, self.expected)

    def _check_type(self):
        __tracebackhide__ = True
        for index, x in enumerate(self.expected):
            if isinstance(x, type(self.expected)):
                msg = "pytest.approx() does not support nested data structures: {!r} at index {}\n  full sequence: {}"
                raise TypeError(msg.format(x, index, pprint.pformat(self.expected)))
            elif not isinstance(x, Number):
                raise _non_numeric_type_error(
                    self.expected, at="index {}".format(index)
                )
~~~

