@x-symbol desc="def validate_and_get_issue_comment_payload(issue_payload_path: Optional[Path])" file="scripts/release-on-comment.py" qual="validate_and_get_issue_comment_payload" lineno=77 endline=87 refs="#scripts-release-on-comment-py--f-get_comment_data" [#scripts-release-on-comment-py--f-validate_and_get_issue_comment_payload]
~~~
def validate_and_get_issue_comment_payload(
    issue_payload_path: Optional[Path],
) -> Tuple[str, str]:
    payload = json.loads(issue_payload_path.read_text(encoding="UTF-8"))
    body = get_comment_data(payload)["body"]
    m = re.match(r"@pytestbot please prepare release from ([\w\-_\.]+)", body)
    if m:
        base_branch = m.group(1)
    else:
        base_branch = None
    return payload, base_branch
~~~

