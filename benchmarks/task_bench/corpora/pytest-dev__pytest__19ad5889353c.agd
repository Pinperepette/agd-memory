@x-symbol desc="def pytest_collectreport(self, report: CollectReport)" file="src/_pytest/terminal.py" qual="TerminalReporter.pytest_collectreport" lineno=605 endline=613 refs="#src-_pytest-terminal-py--c-terminalreporter--m-_add_stats,#src-_pytest-terminal-py--c-terminalreporter--m-report_collect" [#src-_pytest-terminal-py--c-terminalreporter--m-pytest_collectreport]
~~~
    def pytest_collectreport(self, report: CollectReport) -> None:
        if report.failed:
            self._add_stats("error", [report])
        elif report.skipped:
            self._add_stats("skipped", [report])
        items = [x for x in report.result if isinstance(x, pytest.Item)]
        self._numcollected += len(items)
        if self.isatty:
            self.report_collect()
~~~

@x-symbol desc="def report_collect(self, final: bool=False)" file="src/_pytest/terminal.py" qual="TerminalReporter.report_collect" lineno=615 endline=653 refs="#src-_pytest-terminal-py--c-terminalreporter--m-rewrite,#src-_pytest-terminal-py--c-terminalreporter--m-write_line,#src-_pytest-terminal-py--c-terminalreporter--m-write" [#src-_pytest-terminal-py--c-terminalreporter--m-report_collect]
~~~
    def report_collect(self, final: bool = False) -> None:
        if self.config.option.verbose < 0:
            return

        if not final:
            # Only write "collecting" report every 0.5s.
            t = timing.time()
            if (
                self._collect_report_last_write is not None
                and self._collect_report_last_write > t - REPORT_COLLECTING_RESOLUTION
            ):
                return
            self._collect_report_last_write = t

        errors = len(self.stats.get("error", []))
        skipped = len(self.stats.get("skipped", []))
        deselected = len(self.stats.get("deselected", []))
        selected = self._numcollected - errors - skipped - deselected
        if final:
            line = "collected "
        else:
            line = "collecting "
        line += (
            str(self._numcollected) + " item" + ("" if self._numcollected == 1 else "s")
        )
        if errors:
            line += " / %d error%s" % (errors, "s" if errors != 1 else "")
        if deselected:
            line += " / %d deselected" % deselected
        if skipped:
            line += " / %d skipped" % skipped
        if self._numcollected > selected > 0:
            line += " / %d selected" % selected
        if self.isatty:
            self.rewrite(line, bold=True, erase=True)
            if final:
                self.write("\n")
        else:
            self.write_line(line)
~~~

@x-symbol desc="def pytest_sessionstart(self, session: 'Session')" file="src/_pytest/terminal.py" qual="TerminalReporter.pytest_sessionstart" lineno=656 endline=681 refs="#src-_pytest-terminal-py--c-terminalreporter--m-write_sep,#src-_pytest-terminal-py--c-terminalreporter--m-write_line,#src-_pytest-terminal-py--c-terminalreporter--m-pytest_report_header,#src-_pytest-terminal-py--c-terminalreporter--m-_write_report_lines_from_hooks" [#src-_pytest-terminal-py--c-terminalreporter--m-pytest_sessionstart]
~~~
    def pytest_sessionstart(self, session: "Session") -> None:
        self._session = session
        self._sessionstarttime = timing.time()
        if not self.showheader:
            return
        self.write_sep("=", "test session starts", bold=True)
        verinfo = platform.python_version()
        msg = "platform {} -- Python {}".format(sys.platform, verinfo)
        pypy_version_info = getattr(sys, "pypy_version_info", None)
        if pypy_version_info:
            verinfo = ".".join(map(str, pypy_version_info[:3]))
            msg += "[pypy-{}-{}]".format(verinfo, pypy_version_info[3])
        msg += ", pytest-{}, py-{}, pluggy-{}".format(
            pytest.__version__, py.__version__, pluggy.__version__
        )
        if (
            self.verbosity > 0
            or self.config.option.debug
            or getattr(self.config.option, "pastebin", None)
        ):
            msg += " -- " + str(sys.executable)
        self.write_line(msg)
        lines = self.config.hook.pytest_report_header(
            config=self.config, startdir=self.startdir
        )
        self._write_report_lines_from_hooks(lines)
~~~

@x-symbol desc="def _write_report_lines_from_hooks(self, lines: List[Union[str, List[str]]])" file="src/_pytest/terminal.py" qual="TerminalReporter._write_report_lines_from_hooks" lineno=683 endline=688 refs="#src-_pytest-terminal-py--c-terminalreporter--m-write_line" [#src-_pytest-terminal-py--c-terminalreporter--m-_write_report_lines_from_hooks]
~~~
    def _write_report_lines_from_hooks(
        self, lines: List[Union[str, List[str]]]
    ) -> None:
        lines.reverse()
        for line in collapse(lines):
            self.write_line(line)
~~~

@x-symbol desc="def pytest_report_header(self, config: Config)" file="src/_pytest/terminal.py" qual="TerminalReporter.pytest_report_header" lineno=690 endline=705 refs="#src-_pytest-terminal-py--f-_plugin_nameversions" [#src-_pytest-terminal-py--c-terminalreporter--m-pytest_report_header]
~~~
    def pytest_report_header(self, config: Config) -> List[str]:
        line = "rootdir: %s" % config.rootdir

        if config.inifile:
            line += ", inifile: " + config.rootdir.bestrelpath(config.inifile)

        testpaths = config.getini("testpaths")
        if testpaths and config.args == testpaths:
            rel_paths = [config.rootdir.bestrelpath(x) for x in testpaths]
            line += ", testpaths: {}".format(", ".join(rel_paths))
        result = [line]

        plugininfo = config.pluginmanager.list_plugin_distinfo()
        if plugininfo:
            result.append("plugins: %s" % ", ".join(_plugin_nameversions(plugininfo)))
        return result
~~~

@x-symbol desc="def pytest_collection_finish(self, session: 'Session')" file="src/_pytest/terminal.py" qual="TerminalReporter.pytest_collection_finish" lineno=707 endline=725 refs="#src-_pytest-terminal-py--c-terminalreporter--m-report_collect,#src-_pytest-terminal-py--c-terminalreporter--m-_write_report_lines_from_hooks,#src-_pytest-terminal-py--c-terminalreporter--m-_printcollecteditems,#src-_pytest-terminal-py--c-terminalreporter--m-line" [#src-_pytest-terminal-py--c-terminalreporter--m-pytest_collection_finish]
~~~
    def pytest_collection_finish(self, session: "Session") -> None:
        self.report_collect(True)

        lines = self.config.hook.pytest_report_collectionfinish(
            config=self.config, startdir=self.startdir, items=session.items
        )
        self._write_report_lines_from_hooks(lines)

        if self.config.getoption("collectonly"):
            if session.items:
                if self.config.option.verbose > -1:
                    self._tw.line("")
                self._printcollecteditems(session.items)

            failed = self.stats.get("failed")
            if failed:
                self._tw.sep("!", "collection failures")
                for rep in failed:
                    rep.toterminal(self._tw)
~~~

@x-symbol desc="def _printcollecteditems(self, items: Sequence[Item])" file="src/_pytest/terminal.py" qual="TerminalReporter._printcollecteditems" lineno=727 endline=762 refs="#src-_pytest-terminal-py--c-terminalreporter--m-line" [#src-_pytest-terminal-py--c-terminalreporter--m-_printcollecteditems]
~~~
    def _printcollecteditems(self, items: Sequence[Item]) -> None:
        # to print out items and their parent collectors
        # we take care to leave out Instances aka ()
        # because later versions are going to get rid of them anyway
        if self.config.option.verbose < 0:
            if self.config.option.verbose < -1:
                counts = {}  # type: Dict[str, int]
                for item in items:
                    name = item.nodeid.split("::", 1)[0]
                    counts[name] = counts.get(name, 0) + 1
                for name, count in sorted(counts.items()):
                    self._tw.line("%s: %d" % (name, count))
            else:
                for item in items:
                    self._tw.line(item.nodeid)
            return
        stack = []  # type: List[Node]
        indent = ""
        for item in items:
            needed_collectors = item.listchain()[1:]  # strip root node
            while stack:
                if stack == needed_collectors[: len(stack)]:
                    break
                stack.pop()
            for col in needed_collectors[len(stack) :]:
                stack.append(col)
                if col.name == "()":  # Skip Instances.
                    continue
                indent = (len(stack) - 1) * "  "
                self._tw.line("{}{}".format(indent, col))
                if self.config.option.verbose >= 1:
                    obj = getattr(col, "obj", None)
                    doc = inspect.getdoc(obj) if obj else None
                    if doc:
                        for line in doc.splitlines():
                            self._tw.line("{}{}".format(indent + "  ", line))
~~~

@x-symbol desc="def pytest_sessionfinish(self, session: 'Session', exitstatus: Union[int, ExitCode])" file="src/_pytest/terminal.py" qual="TerminalReporter.pytest_sessionfinish" lineno=765 endline=789 refs="#src-_pytest-terminal-py--c-terminalreporter--m-line,#src-_pytest-terminal-py--c-terminalreporter--m-summary_stats,#src-_pytest-terminal-py--c-terminalreporter--m-pytest_terminal_summary,#src-_pytest-terminal-py--c-terminalreporter--m-write_sep,#src-_pytest-terminal-py--c-terminalreporter--m-_report_keyboardinterrupt" [#src-_pytest-terminal-py--c-terminalreporter--m-pytest_sessionfinish]
~~~
    def pytest_sessionfinish(
        self, session: "Session", exitstatus: Union[int, ExitCode]
    ):
        outcome = yield
        outcome.get_result()
        self._tw.line("")
        summary_exit_codes = (
            ExitCode.OK,
            ExitCode.TESTS_FAILED,
            ExitCode.INTERRUPTED,
            ExitCode.USAGE_ERROR,
            ExitCode.NO_TESTS_COLLECTED,
        )
        if exitstatus in summary_exit_codes:
            self.config.hook.pytest_terminal_summary(
                terminalreporter=self, exitstatus=exitstatus, config=self.config
            )
        if session.shouldfail:
            self.write_sep("!", str(session.shouldfail), red=True)
        if exitstatus == ExitCode.INTERRUPTED:
            self._report_keyboardinterrupt()
            del self._keyboardinterrupt_memo
        elif session.shouldstop:
            self.write_sep("!", str(session.shouldstop), red=True)
        self.summary_stats()
~~~

@x-symbol desc="def pytest_terminal_summary(self)" file="src/_pytest/terminal.py" qual="TerminalReporter.pytest_terminal_summary" lineno=792 endline=800 refs="#src-_pytest-terminal-py--c-terminalreporter--m-summary_errors,#src-_pytest-terminal-py--c-terminalreporter--m-summary_failures,#src-_pytest-terminal-py--c-terminalreporter--m-summary_warnings,#src-_pytest-terminal-py--c-terminalreporter--m-summary_passes,#src-_pytest-terminal-py--c-terminalreporter--m-short_test_summary" [#src-_pytest-terminal-py--c-terminalreporter--m-pytest_terminal_summary]
