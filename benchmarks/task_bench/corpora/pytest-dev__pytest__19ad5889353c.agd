@x-symbol desc="def _main(config: Config, session: 'Session')" file="src/_pytest/main.py" qual="_main" lineno=253 endline=263 refs="#src-_pytest-main-py--f-pytest_collection,#src-_pytest-main-py--f-pytest_runtestloop" [#src-_pytest-main-py--f-_main]
~~~
def _main(config: Config, session: "Session") -> Optional[Union[int, ExitCode]]:
    """ default command line protocol for initialization, session,
    running tests and reporting. """
    config.hook.pytest_collection(session=session)
    config.hook.pytest_runtestloop(session=session)

    if session.testsfailed:
        return ExitCode.TESTS_FAILED
    elif session.testscollected == 0:
        return ExitCode.NO_TESTS_COLLECTED
    return None
~~~

