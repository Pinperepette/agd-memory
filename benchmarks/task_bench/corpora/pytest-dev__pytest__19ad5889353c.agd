@x-symbol desc="def test_traceback_no_recursion_index(self)" file="testing/code/test_excinfo.py" qual="TestTraceback_f_g_h.test_traceback_no_recursion_index" lineno=234 endline=255 [#testing-code-test_excinfo-py--c-testtraceback_f_g_h--m-test_traceback_no_recursion_index]
~~~
    def test_traceback_no_recursion_index(self) -> None:
        def do_stuff() -> None:
            raise RuntimeError

        def reraise_me() -> None:
            import sys

            exc, val, tb = sys.exc_info()
            assert val is not None
            raise val.with_traceback(tb)

        def f(n: int) -> None:
            try:
                do_stuff()
            except BaseException:
                reraise_me()

        excinfo = pytest.raises(RuntimeError, f, 8)
        assert excinfo is not None
        traceback = excinfo.traceback
        recindex = traceback.recursionindex()
        assert recindex is None
~~~

