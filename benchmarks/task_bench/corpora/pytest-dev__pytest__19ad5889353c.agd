@x-symbol desc="def print_teardown_sections(self, rep: TestReport)" file="src/_pytest/terminal.py" qual="TerminalReporter.print_teardown_sections" lineno=953 endline=964 refs="#src-_pytest-terminal-py--c-terminalreporter--m-line" [#src-_pytest-terminal-py--c-terminalreporter--m-print_teardown_sections]
~~~
    def print_teardown_sections(self, rep: TestReport) -> None:
        showcapture = self.config.option.showcapture
        if showcapture == "no":
            return
        for secname, content in rep.sections:
            if showcapture != "all" and showcapture not in secname:
                continue
            if "teardown" in secname:
                self._tw.sep("-", secname)
                if content[-1:] == "\n":
                    content = content[:-1]
                self._tw.line(content)
~~~

@x-symbol desc="def summary_failures(self)" file="src/_pytest/terminal.py" qual="TerminalReporter.summary_failures" lineno=966 endline=981 refs="#src-_pytest-terminal-py--c-terminalreporter--m-getreports,#src-_pytest-terminal-py--c-terminalreporter--m-write_sep,#src-_pytest-terminal-py--c-terminalreporter--m-_getcrashline,#src-_pytest-terminal-py--c-terminalreporter--m-write_line,#src-_pytest-terminal-py--c-terminalreporter--m-_getfailureheadline,#src-_pytest-terminal-py--c-terminalreporter--m-_outrep_summary,#src-_pytest-terminal-py--c-terminalreporter--m-_handle_teardown_sections" [#src-_pytest-terminal-py--c-terminalreporter--m-summary_failures]
~~~
    def summary_failures(self) -> None:
        if self.config.option.tbstyle != "no":
            reports = self.getreports("failed")  # type: List[BaseReport]
            if not reports:
                return
            self.write_sep("=", "FAILURES")
            if self.config.option.tbstyle == "line":
                for rep in reports:
                    line = self._getcrashline(rep)
                    self.write_line(line)
            else:
                for rep in reports:
                    msg = self._getfailureheadline(rep)
                    self.write_sep("_", msg, red=True, bold=True)
                    self._outrep_summary(rep)
                    self._handle_teardown_sections(rep.nodeid)
~~~

@x-symbol desc="def summary_errors(self)" file="src/_pytest/terminal.py" qual="TerminalReporter.summary_errors" lineno=983 endline=996 refs="#src-_pytest-terminal-py--c-terminalreporter--m-getreports,#src-_pytest-terminal-py--c-terminalreporter--m-write_sep,#src-_pytest-terminal-py--c-terminalreporter--m-_getfailureheadline,#src-_pytest-terminal-py--c-terminalreporter--m-_outrep_summary" [#src-_pytest-terminal-py--c-terminalreporter--m-summary_errors]
~~~
    def summary_errors(self) -> None:
        if self.config.option.tbstyle != "no":
            reports = self.getreports("error")  # type: List[BaseReport]
            if not reports:
                return
            self.write_sep("=", "ERRORS")
            for rep in self.stats["error"]:
                msg = self._getfailureheadline(rep)
                if rep.when == "collect":
                    msg = "ERROR collecting " + msg
                else:
                    msg = "ERROR at {} of {}".format(rep.when, msg)
                self.write_sep("_", msg, red=True, bold=True)
                self._outrep_summary(rep)
~~~

@x-symbol desc="def _outrep_summary(self, rep: BaseReport)" file="src/_pytest/terminal.py" qual="TerminalReporter._outrep_summary" lineno=998 endline=1009 refs="#src-_pytest-terminal-py--c-terminalreporter--m-line" [#src-_pytest-terminal-py--c-terminalreporter--m-_outrep_summary]
