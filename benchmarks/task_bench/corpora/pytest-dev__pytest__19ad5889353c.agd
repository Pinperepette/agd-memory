@h2 testing/example_scripts/perf_examples/collect_stats/generate_folders.py [#file--testing-example_scripts-perf_examples-collect_stats-generate_folders-py]

@x-symbol desc="def generate_folders(root, elements, *more_numbers)" file="testing/example_scripts/perf_examples/collect_stats/generate_folders.py" qual="generate_folders" lineno=11 endline=22 [#testing-example_scripts-perf_examples-collect_stats-generate_folders-py--f-generate_folders]
~~~
def generate_folders(root, elements, *more_numbers):
    fill_len = len(str(elements))
    if more_numbers:
        for i in range(elements):
            new_folder = root.joinpath(f"foo_{i:0>{fill_len}}")
            new_folder.mkdir()
            new_folder.joinpath("__init__.py").write_bytes(TEST_CONTENT)
            generate_folders(new_folder, *more_numbers)
    else:
        for i in range(elements):
            new_test = root.joinpath(f"test_{i:0<{fill_len}}.py")
            new_test.write_bytes(TEST_CONTENT)
~~~

