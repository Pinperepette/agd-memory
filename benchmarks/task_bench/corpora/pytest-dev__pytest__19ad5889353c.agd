@x-symbol desc="class PytestArg" file="src/_pytest/pytester.py" qual="PytestArg" lineno=178 endline=185 refs="#src-_pytest-pytester-py--c-hookrecorder" [#src-_pytest-pytester-py--c-pytestarg]
~~~
class PytestArg:
    def __init__(self, request: FixtureRequest) -> None:
        self.request = request

    def gethookrecorder(self, hook) -> "HookRecorder":
        hookrecorder = HookRecorder(hook._pm)
        self.request.addfinalizer(hookrecorder.finish_recording)
        return hookrecorder
~~~

