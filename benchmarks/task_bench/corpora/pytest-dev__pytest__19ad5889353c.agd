@x-symbol desc="def summary_stats(self)" file="src/_pytest/terminal.py" qual="TerminalReporter.summary_stats" lineno=1011 endline=1046 refs="#src-_pytest-terminal-py--c-terminalreporter--m-build_summary_stats_line,#src-_pytest-terminal-py--f-format_session_duration,#src-_pytest-terminal-py--c-terminalreporter--m-write_sep,#src-_pytest-terminal-py--c-terminalreporter--m-write_line" [#src-_pytest-terminal-py--c-terminalreporter--m-summary_stats]
~~~
    def summary_stats(self) -> None:
        if self.verbosity < -1:
            return

        session_duration = timing.time() - self._sessionstarttime
        (parts, main_color) = self.build_summary_stats_line()
        line_parts = []

        display_sep = self.verbosity >= 0
        if display_sep:
            fullwidth = self._tw.fullwidth
        for text, markup in parts:
            with_markup = self._tw.markup(text, **markup)
            if display_sep:
                fullwidth += len(with_markup) - len(text)
            line_parts.append(with_markup)
        msg = ", ".join(line_parts)

        main_markup = {main_color: True}
        duration = " in {}".format(format_session_duration(session_duration))
        duration_with_markup = self._tw.markup(duration, **main_markup)
        if display_sep:
            fullwidth += len(duration_with_markup) - len(duration)
        msg += duration_with_markup

        if display_sep:
            markup_for_end_sep = self._tw.markup("", **main_markup)
            if markup_for_end_sep.endswith("\x1b[0m"):
                markup_for_end_sep = markup_for_end_sep[:-4]
            fullwidth += len(markup_for_end_sep)
            msg += markup_for_end_sep

        if display_sep:
            self.write_sep("=", msg, fullwidth=fullwidth, **main_markup)
        else:
            self.write_line(msg, **main_markup)
~~~

@x-symbol desc="def short_test_summary(self)" file="src/_pytest/terminal.py" qual="TerminalReporter.short_test_summary" lineno=1048 endline=1115 refs="#src-_pytest-terminal-py--c-terminalreporter--m-write_sep,#src-_pytest-terminal-py--f-_get_line_with_reprcrash_message,#src-_pytest-terminal-py--f-_get_pos,#src-_pytest-terminal-py--f-_folded_skips,#src-_pytest-terminal-py--c-terminalreporter--m-write_line" [#src-_pytest-terminal-py--c-terminalreporter--m-short_test_summary]
~~~
    def short_test_summary(self) -> None:
        if not self.reportchars:
            return

        def show_simple(stat, lines: List[str]) -> None:
            failed = self.stats.get(stat, [])
            if not failed:
                return
            termwidth = self._tw.fullwidth
            config = self.config
            for rep in failed:
                line = _get_line_with_reprcrash_message(config, rep, termwidth)
                lines.append(line)

        def show_xfailed(lines: List[str]) -> None:
            xfailed = self.stats.get("xfailed", [])
            for rep in xfailed:
                verbose_word = rep._get_verbose_word(self.config)
                pos = _get_pos(self.config, rep)
                lines.append("{} {}".format(verbose_word, pos))
                reason = rep.wasxfail
                if reason:
                    lines.append("  " + str(reason))

        def show_xpassed(lines: List[str]) -> None:
            xpassed = self.stats.get("xpassed", [])
            for rep in xpassed:
                verbose_word = rep._get_verbose_word(self.config)
                pos = _get_pos(self.config, rep)
                reason = rep.wasxfail
                lines.append("{} {} {}".format(verbose_word, pos, reason))

        def show_skipped(lines: List[str]) -> None:
            skipped = self.stats.get("skipped", [])  # type: List[CollectReport]
            fskips = _folded_skips(self.startdir, skipped) if skipped else []
            if not fskips:
                return
            verbose_word = skipped[0]._get_verbose_word(self.config)
            for num, fspath, lineno, reason in fskips:
                if reason.startswith("Skipped: "):
                    reason = reason[9:]
                if lineno is not None:
                    lines.append(
                        "%s [%d] %s:%d: %s"
                        % (verbose_word, num, fspath, lineno, reason)
                    )
                else:
                    lines.append("%s [%d] %s: %s" % (verbose_word, num, fspath, reason))

        REPORTCHAR_ACTIONS = {
            "x": show_xfailed,
            "X": show_xpassed,
            "f": partial(show_simple, "failed"),
            "s": show_skipped,
            "p": partial(show_simple, "passed"),
            "E": partial(show_simple, "error"),
        }  # type: Mapping[str, Callable[[List[str]], None]]

        lines = []  # type: List[str]
        for char in self.reportchars:
            action = REPORTCHAR_ACTIONS.get(char)
            if action:  # skipping e.g. "P" (passed with output) here.
                action(lines)

        if lines:
            self.write_sep("=", "short test summary info")
            for line in lines:
                self.write_line(line)
~~~

@x-symbol desc="def _get_main_color(self)" file="src/_pytest/terminal.py" qual="TerminalReporter._get_main_color" lineno=1117 endline=1122 refs="#src-_pytest-terminal-py--c-terminalreporter--m-_set_main_color" [#src-_pytest-terminal-py--c-terminalreporter--m-_get_main_color]
~~~
    def _get_main_color(self) -> Tuple[str, List[str]]:
        if self._main_color is None or self._known_types is None or self._is_last_item:
            self._set_main_color()
            assert self._main_color
            assert self._known_types
        return self._main_color, self._known_types
~~~

@x-symbol desc="def _determine_main_color(self, unknown_type_seen: bool)" file="src/_pytest/terminal.py" qual="TerminalReporter._determine_main_color" lineno=1124 endline=1134 [#src-_pytest-terminal-py--c-terminalreporter--m-_determine_main_color]
~~~
    def _determine_main_color(self, unknown_type_seen: bool) -> str:
        stats = self.stats
        if "failed" in stats or "error" in stats:
            main_color = "red"
        elif "warnings" in stats or "xpassed" in stats or unknown_type_seen:
            main_color = "yellow"
        elif "passed" in stats or not self._is_last_item:
            main_color = "green"
        else:
            main_color = "yellow"
        return main_color
~~~

@x-symbol desc="def _set_main_color(self)" file="src/_pytest/terminal.py" qual="TerminalReporter._set_main_color" lineno=1136 endline=1143 refs="#src-_pytest-terminal-py--c-terminalreporter--m-_determine_main_color" [#src-_pytest-terminal-py--c-terminalreporter--m-_set_main_color]
~~~
    def _set_main_color(self) -> None:
        unknown_types = []  # type: List[str]
        for found_type in self.stats.keys():
            if found_type:  # setup/teardown reports have an empty key, ignore them
                if found_type not in KNOWN_TYPES and found_type not in unknown_types:
                    unknown_types.append(found_type)
        self._known_types = list(KNOWN_TYPES) + unknown_types
        self._main_color = self._determine_main_color(bool(unknown_types))
~~~

@x-symbol desc="def build_summary_stats_line(self)" file="src/_pytest/terminal.py" qual="TerminalReporter.build_summary_stats_line" lineno=1145 endline=1162 refs="#src-_pytest-terminal-py--c-terminalreporter--m-_get_main_color,#src-_pytest-terminal-py--f-_make_plural" [#src-_pytest-terminal-py--c-terminalreporter--m-build_summary_stats_line]
~~~
    def build_summary_stats_line(self) -> Tuple[List[Tuple[str, Dict[str, bool]]], str]:
        main_color, known_types = self._get_main_color()

        parts = []
        for key in known_types:
            reports = self.stats.get(key, None)
            if reports:
                count = sum(
                    1 for rep in reports if getattr(rep, "count_towards_summary", True)
                )
                color = _color_for_type.get(key, _color_for_type_default)
                markup = {color: True, "bold": color == main_color}
                parts.append(("%d %s" % _make_plural(count, key), markup))

        if not parts:
            parts = [("no tests ran", {_color_for_type_default: True})]

        return parts, main_color
~~~

