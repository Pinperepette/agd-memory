@x-symbol desc="def pytest_collection(self)" file="src/_pytest/terminal.py" qual="TerminalReporter.pytest_collection" lineno=597 endline=603 refs="#src-_pytest-terminal-py--c-terminalreporter--m-write" [#src-_pytest-terminal-py--c-terminalreporter--m-pytest_collection]
