@x-symbol desc="def test_pdb_interaction_doctest(self, testdir)" file="testing/test_debugging.py" qual="TestPDB.test_pdb_interaction_doctest" lineno=475 endline=499 refs="#testing-test_debugging-py--c-testpdb--m-flush" [#testing-test_debugging-py--c-testpdb--m-test_pdb_interaction_doctest]
~~~
    def test_pdb_interaction_doctest(self, testdir):
        p1 = testdir.makepyfile(
            """
            def function_1():
                '''
                >>> i = 0
                >>> assert i == 1
                '''
        """
        )
        child = testdir.spawn_pytest("--doctest-modules --pdb %s" % p1)
        child.expect("Pdb")

        assert "UNEXPECTED EXCEPTION: AssertionError()" in child.before.decode("utf8")

        child.sendline("'i=%i.' % i")
        child.expect("Pdb")
        assert "\r\n'i=0.'\r\n" in child.before.decode("utf8")

        child.sendeof()
        rest = child.read().decode("utf8")
        assert "! _pytest.outcomes.Exit: Quitting debugger !" in rest
        assert "BdbQuit" not in rest
        assert "1 failed" in rest
        self.flush(child)
~~~

@x-symbol desc="def test_doctest_set_trace_quit(self, testdir)" file="testing/test_debugging.py" qual="TestPDB.test_doctest_set_trace_quit" lineno=501 endline=520 [#testing-test_debugging-py--c-testpdb--m-test_doctest_set_trace_quit]
~~~
    def test_doctest_set_trace_quit(self, testdir):
        p1 = testdir.makepyfile(
            """
            def function_1():
                '''
                >>> __import__('pdb').set_trace()
                '''
        """
        )
        # NOTE: does not use pytest.set_trace, but Python's patched pdb,
        #       therefore "-s" is required.
        child = testdir.spawn_pytest("--doctest-modules --pdb -s %s" % p1)
        child.expect("Pdb")
        child.sendline("q")
        rest = child.read().decode("utf8")

        assert "! _pytest.outcomes.Exit: Quitting debugger !" in rest
        assert "= no tests ran in" in rest
        assert "BdbQuit" not in rest
        assert "UNEXPECTED EXCEPTION" not in rest
~~~

