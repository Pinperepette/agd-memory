@x-symbol desc="class TestCustomAssertMsg" file="doc/en/example/assertion/failure_demo.py" qual="TestCustomAssertMsg" lineno=256 endline=282 [#doc-en-example-assertion-failure_demo-py--c-testcustomassertmsg]
~~~
class TestCustomAssertMsg:
    def test_single_line(self):
        class A:
            a = 1

        b = 2
        assert A.a == b, "A.a appears not to be b"

    def test_multiline(self):
        class A:
            a = 1

        b = 2
        assert (
            A.a == b
        ), "A.a appears not to be b\nor does not appear to be b\none of those"

    def test_custom_repr(self):
        class JSON:
            a = 1

            def __repr__(self):
                return "This is JSON\n{\n  'foo': 'bar'\n}"

        a = JSON()
        b = 2
        assert a.a == b, a
~~~

