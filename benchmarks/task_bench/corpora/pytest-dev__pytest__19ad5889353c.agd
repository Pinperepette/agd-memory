@x-symbol desc="def test_dontreadfrominput()" file="testing/test_capture.py" qual="test_dontreadfrominput" lineno=840 endline=851 [#testing-test_capture-py--f-test_dontreadfrominput]
~~~
def test_dontreadfrominput():
    from _pytest.capture import DontReadFromInput

    f = DontReadFromInput()
    assert f.buffer is f
    assert not f.isatty()
    pytest.raises(OSError, f.read)
    pytest.raises(OSError, f.readlines)
    iter_f = iter(f)
    pytest.raises(OSError, next, iter_f)
    pytest.raises(UnsupportedOperation, f.fileno)
    f.close()  # just for completeness
~~~

