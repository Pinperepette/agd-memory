@x-symbol desc="class TestAssert_reprcompare_dataclass" file="testing/test_assertion.py" qual="TestAssert_reprcompare_dataclass" lineno=773 endline=815 [#testing-test_assertion-py--c-testassert_reprcompare_dataclass]
