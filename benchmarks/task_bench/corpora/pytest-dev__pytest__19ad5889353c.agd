@x-symbol desc="def expression(s: Scanner)" file="src/_pytest/mark/expression.py" qual="expression" lineno=130 endline=136 refs="#src-_pytest-mark-expression-py--c-scanner--m-accept,#src-_pytest-mark-expression-py--f-expr,#src-_pytest-mark-expression-py--c-expression" [#src-_pytest-mark-expression-py--f-expression]
~~~
def expression(s: Scanner) -> ast.Expression:
    if s.accept(TokenType.EOF):
        ret = ast.NameConstant(False)  # type: ast.expr
    else:
        ret = expr(s)
        s.accept(TokenType.EOF, reject=True)
    return ast.fix_missing_locations(ast.Expression(ret))
~~~

@x-symbol desc="def expr(s: Scanner)" file="src/_pytest/mark/expression.py" qual="expr" lineno=139 endline=144 refs="#src-_pytest-mark-expression-py--f-and_expr,#src-_pytest-mark-expression-py--c-scanner--m-accept" [#src-_pytest-mark-expression-py--f-expr]
~~~
def expr(s: Scanner) -> ast.expr:
    ret = and_expr(s)
    while s.accept(TokenType.OR):
        rhs = and_expr(s)
        ret = ast.BoolOp(ast.Or(), [ret, rhs])
    return ret
~~~

@x-symbol desc="def and_expr(s: Scanner)" file="src/_pytest/mark/expression.py" qual="and_expr" lineno=147 endline=152 refs="#src-_pytest-mark-expression-py--f-not_expr,#src-_pytest-mark-expression-py--c-scanner--m-accept" [#src-_pytest-mark-expression-py--f-and_expr]
~~~
def and_expr(s: Scanner) -> ast.expr:
    ret = not_expr(s)
    while s.accept(TokenType.AND):
        rhs = not_expr(s)
        ret = ast.BoolOp(ast.And(), [ret, rhs])
    return ret
~~~

@x-symbol desc="def not_expr(s: Scanner)" file="src/_pytest/mark/expression.py" qual="not_expr" lineno=155 endline=165 refs="#src-_pytest-mark-expression-py--c-scanner--m-accept,#src-_pytest-mark-expression-py--c-scanner--m-reject,#src-_pytest-mark-expression-py--f-expr" [#src-_pytest-mark-expression-py--f-not_expr]
~~~
def not_expr(s: Scanner) -> ast.expr:
    if s.accept(TokenType.NOT):
        return ast.UnaryOp(ast.Not(), not_expr(s))
    if s.accept(TokenType.LPAREN):
        ret = expr(s)
        s.accept(TokenType.RPAREN, reject=True)
        return ret
    ident = s.accept(TokenType.IDENT)
    if ident:
        return ast.Name(ident.value, ast.Load())
    s.reject((TokenType.NOT, TokenType.LPAREN, TokenType.IDENT))
~~~

@x-symbol desc="class MatcherAdapter(Mapping[str, bool])" file="src/_pytest/mark/expression.py" qual="MatcherAdapter" lineno=168 endline=181 [#src-_pytest-mark-expression-py--c-matcheradapter]
~~~
class MatcherAdapter(Mapping[str, bool]):
    """Adapts a matcher function to a locals mapping as required by eval()."""

    def __init__(self, matcher: Callable[[str], bool]) -> None:
        self.matcher = matcher

    def __getitem__(self, key: str) -> bool:
        return self.matcher(key)

    def __iter__(self) -> Iterator[str]:
        raise NotImplementedError()

    def __len__(self) -> int:
        raise NotImplementedError()
~~~

