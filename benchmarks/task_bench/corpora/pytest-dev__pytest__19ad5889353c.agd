@x-symbol desc="def test_pdb_interaction_on_internal_error(self, testdir)" file="testing/test_debugging.py" qual="TestPDB.test_pdb_interaction_on_internal_error" lineno=319 endline=343 refs="#testing-test_debugging-py--c-testpdb--m-flush" [#testing-test_debugging-py--c-testpdb--m-test_pdb_interaction_on_internal_error]
~~~
    def test_pdb_interaction_on_internal_error(self, testdir):
        testdir.makeconftest(
            """
            def pytest_runtest_protocol():
                0/0
        """
        )
        p1 = testdir.makepyfile("def test_func(): pass")
        child = testdir.spawn_pytest("--pdb %s" % p1)
        child.expect("Pdb")

        # INTERNALERROR is only displayed once via terminal reporter.
        assert (
            len(
                [
                    x
                    for x in child.before.decode().splitlines()
                    if x.startswith("INTERNALERROR> Traceback")
                ]
            )
            == 1
        )

        child.sendeof()
        self.flush(child)
~~~

