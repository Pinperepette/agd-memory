@x-symbol desc="def prepare(self, colitem)" file="src/_pytest/runner.py" qual="SetupState.prepare" lineno=411 endline=428 refs="#src-_pytest-runner-py--c-setupstate--m-_teardown_towards" [#src-_pytest-runner-py--c-setupstate--m-prepare]
