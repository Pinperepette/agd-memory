@x-symbol desc="def copy_example(self, name=None)" file="src/_pytest/pytester.py" qual="Testdir.copy_example" lineno=755 endline=803 [#src-_pytest-pytester-py--c-testdir--m-copy_example]
~~~
    def copy_example(self, name=None):
        """Copy file from project's directory into the testdir.

        :param str name: The name of the file to copy.
        :return: path to the copied directory (inside ``self.tmpdir``).

        """
        import warnings
        from _pytest.warning_types import PYTESTER_COPY_EXAMPLE

        warnings.warn(PYTESTER_COPY_EXAMPLE, stacklevel=2)
        example_dir = self.request.config.getini("pytester_example_dir")
        if example_dir is None:
            raise ValueError("pytester_example_dir is unset, can't copy examples")
        example_dir = self.request.config.rootdir.join(example_dir)

        for extra_element in self.request.node.iter_markers("pytester_example_path"):
            assert extra_element.args
            example_dir = example_dir.join(*extra_element.args)

        if name is None:
            func_name = self._name
            maybe_dir = example_dir / func_name
            maybe_file = example_dir / (func_name + ".py")

            if maybe_dir.isdir():
                example_path = maybe_dir
            elif maybe_file.isfile():
                example_path = maybe_file
            else:
                raise LookupError(
                    "{} cant be found as module or package in {}".format(
                        func_name, example_dir.bestrelpath(self.request.config.rootdir)
                    )
                )
        else:
            example_path = example_dir.join(name)

        if example_path.isdir() and not example_path.join("__init__.py").isfile():
            example_path.copy(self.tmpdir)
            return self.tmpdir
        elif example_path.isfile():
            result = self.tmpdir.join(example_path.basename)
            example_path.copy(result)
            return result
        else:
            raise LookupError(
                'example "{}" is not found as a file or directory'.format(example_path)
            )
~~~

@x-symbol desc="def getnode(self, config, arg)" file="src/_pytest/pytester.py" qual="Testdir.getnode" lineno=807 endline=823 refs="#src-_pytest-pytester-py--c-linematcher--m-str" [#src-_pytest-pytester-py--c-testdir--m-getnode]
~~~
    def getnode(self, config, arg):
        """Return the collection node of a file.

        :param config: :py:class:`_pytest.config.Config` instance, see
           :py:meth:`parseconfig` and :py:meth:`parseconfigure` to create the
           configuration

        :param arg: a :py:class:`py.path.local` instance of the file

        """
        session = Session.from_config(config)
        assert "::" not in str(arg)
        p = py.path.local(arg)
        config.hook.pytest_sessionstart(session=session)
        res = session.perform_collect([str(p)], genitems=False)[0]
        config.hook.pytest_sessionfinish(session=session, exitstatus=ExitCode.OK)
        return res
~~~

@x-symbol desc="def getpathnode(self, path)" file="src/_pytest/pytester.py" qual="Testdir.getpathnode" lineno=825 endline=840 refs="#src-_pytest-pytester-py--c-testdir--m-parseconfigure" [#src-_pytest-pytester-py--c-testdir--m-getpathnode]
~~~
    def getpathnode(self, path):
        """Return the collection node of a file.

        This is like :py:meth:`getnode` but uses :py:meth:`parseconfigure` to
        create the (configured) pytest Config instance.

        :param path: a :py:class:`py.path.local` instance of the file

        """
        config = self.parseconfigure(path)
        session = Session.from_config(config)
        x = session.fspath.bestrelpath(path)
        config.hook.pytest_sessionstart(session=session)
        res = session.perform_collect([x], genitems=False)[0]
        config.hook.pytest_sessionfinish(session=session, exitstatus=ExitCode.OK)
        return res
~~~

@x-symbol desc="def genitems(self, colitems: List[Union[Item, Collector]])" file="src/_pytest/pytester.py" qual="Testdir.genitems" lineno=842 endline=853 [#src-_pytest-pytester-py--c-testdir--m-genitems]
~~~
    def genitems(self, colitems: List[Union[Item, Collector]]) -> List[Item]:
        """Generate all test items from a collection node.

        This recurses into the collection node and returns a list of all the
        test items contained within.

        """
        session = colitems[0].session
        result = []  # type: List[Item]
        for colitem in colitems:
            result.extend(session.genitems(colitem))
        return result
~~~

@x-symbol desc="def runitem(self, source)" file="src/_pytest/pytester.py" qual="Testdir.runitem" lineno=855 endline=869 refs="#src-_pytest-pytester-py--c-testdir--m-getitem" [#src-_pytest-pytester-py--c-testdir--m-runitem]
~~~
    def runitem(self, source):
        """Run the "test_func" Item.

        The calling test instance (class containing the test method) must
        provide a ``.getrunner()`` method which should return a runner which
        can run the test protocol for a single item, e.g.
        :py:func:`_pytest.runner.runtestprotocol`.

        """
        # used from runner functional tests
        item = self.getitem(source)
        # the test class where we are called from wants to provide the runner
        testclassinstance = self.request.instance
        runner = testclassinstance.getrunner()
        return runner(item)
~~~

@x-symbol desc="def inline_runsource(self, source, *cmdlineargs)" file="src/_pytest/pytester.py" qual="Testdir.inline_runsource" lineno=871 endline=887 refs="#src-_pytest-pytester-py--c-testdir--m-makepyfile,#src-_pytest-pytester-py--c-testdir--m-inline_run" [#src-_pytest-pytester-py--c-testdir--m-inline_runsource]
