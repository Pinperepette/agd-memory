@x-symbol desc="def _try_repr_or_str(obj: object)" file="src/_pytest/_io/saferepr.py" qual="_try_repr_or_str" lineno=9 endline=15 refs="#src-_pytest-_io-saferepr-py--c-saferepr--m-repr" [#src-_pytest-_io-saferepr-py--f-_try_repr_or_str]
~~~
def _try_repr_or_str(obj: object) -> str:
    try:
        return repr(obj)
    except (KeyboardInterrupt, SystemExit):
        raise
    except BaseException:
        return '{}("{}")'.format(type(obj).__name__, obj)
~~~

@x-symbol desc="def _format_repr_exception(exc: BaseException, obj: object)" file="src/_pytest/_io/saferepr.py" qual="_format_repr_exception" lineno=18 endline=27 refs="#src-_pytest-_io-saferepr-py--f-_try_repr_or_str" [#src-_pytest-_io-saferepr-py--f-_format_repr_exception]
~~~
def _format_repr_exception(exc: BaseException, obj: object) -> str:
    try:
        exc_info = _try_repr_or_str(exc)
    except (KeyboardInterrupt, SystemExit):
        raise
    except BaseException as exc:
        exc_info = "unpresentable exception ({})".format(_try_repr_or_str(exc))
    return "<[{} raised in repr()] {} object at 0x{:x}>".format(
        exc_info, type(obj).__name__, id(obj)
    )
~~~

@x-symbol desc="def _ellipsize(s: str, maxsize: int)" file="src/_pytest/_io/saferepr.py" qual="_ellipsize" lineno=30 endline=35 [#src-_pytest-_io-saferepr-py--f-_ellipsize]
~~~
def _ellipsize(s: str, maxsize: int) -> str:
    if len(s) > maxsize:
        i = max(0, (maxsize - 3) // 2)
        j = max(0, maxsize - 3 - i)
        return s[:i] + "..." + s[len(s) - j :]
    return s
~~~

@x-symbol desc="class SafeRepr(reprlib.Repr)" file="src/_pytest/_io/saferepr.py" qual="SafeRepr" lineno=38 endline=64 refs="#src-_pytest-_io-saferepr-py--c-saferepr--m-__init__,#src-_pytest-_io-saferepr-py--f-_ellipsize,#src-_pytest-_io-saferepr-py--c-saferepr--m-repr,#src-_pytest-_io-saferepr-py--f-_format_repr_exception" [#src-_pytest-_io-saferepr-py--c-saferepr]
~~~
class SafeRepr(reprlib.Repr):
    """subclass of repr.Repr that limits the resulting size of repr()
    and includes information on exceptions raised during the call.
    """

    def __init__(self, maxsize: int) -> None:
        super().__init__()
        self.maxstring = maxsize
        self.maxsize = maxsize

    def repr(self, x: object) -> str:
        try:
            s = super().repr(x)
        except (KeyboardInterrupt, SystemExit):
            raise
        except BaseException as exc:
            s = _format_repr_exception(exc, x)
        return _ellipsize(s, self.maxsize)

    def repr_instance(self, x: object, level: int) -> str:
        try:
            s = repr(x)
        except (KeyboardInterrupt, SystemExit):
            raise
        except BaseException as exc:
            s = _format_repr_exception(exc, x)
        return _ellipsize(s, self.maxsize)
~~~

