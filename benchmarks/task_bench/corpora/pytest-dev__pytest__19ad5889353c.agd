    def test_timing_function(self, testdir, run_and_parse, mock_timing):
        testdir.makepyfile(
            """
            from _pytest import timing
            def setup_module():
                timing.sleep(1)
            def teardown_module():
                timing.sleep(2)
            def test_sleep():
                timing.sleep(4)
        """
        )
        result, dom = run_and_parse()
        node = dom.find_first_by_tag("testsuite")
        tnode = node.find_first_by_tag("testcase")
        val = tnode["time"]
        assert float(val) == 7.0
~~~

@x-symbol desc="def test_junit_duration_report(self, testdir, monkeypatch, duration_report, run_and_parse)" file="testing/test_junitxml.py" qual="TestPython.test_junit_duration_report" lineno=229 endline=259 refs="#testing-test_junitxml-py--f-run_and_parse,#testing-test_junitxml-py--c-domnode--m-find_first_by_tag" [#testing-test_junitxml-py--c-testpython--m-test_junit_duration_report]
~~~
    def test_junit_duration_report(
        self, testdir, monkeypatch, duration_report, run_and_parse
    ):

        # mock LogXML.node_reporter so it always sets a known duration to each test report object
        original_node_reporter = LogXML.node_reporter

        def node_reporter_wrapper(s, report):
            report.duration = 1.0
            reporter = original_node_reporter(s, report)
            return reporter

        monkeypatch.setattr(LogXML, "node_reporter", node_reporter_wrapper)

        testdir.makepyfile(
            """
            def test_foo():
                pass
        """
        )
        result, dom = run_and_parse(
            "-o", "junit_duration_report={}".format(duration_report)
        )
        node = dom.find_first_by_tag("testsuite")
        tnode = node.find_first_by_tag("testcase")
        val = float(tnode["time"])
        if duration_report == "total":
            assert val == 3.0
        else:
            assert duration_report == "call"
            assert val == 1.0
~~~

@x-symbol desc="def test_setup_error(self, testdir, run_and_parse, xunit_family)" file="testing/test_junitxml.py" qual="TestPython.test_setup_error" lineno=262 endline=282 refs="#testing-test_junitxml-py--f-run_and_parse,#testing-test_junitxml-py--c-domnode--m-find_first_by_tag,#testing-test_junitxml-py--c-domnode--m-assert_attr,#testing-test_junitxml-py--c-domnode--m-toxml" [#testing-test_junitxml-py--c-testpython--m-test_setup_error]
