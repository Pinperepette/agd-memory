~~~
    def finalize(self):
        """Clean up global state artifacts.

        Some methods modify the global interpreter state and this tries to
        clean this up.  It does not remove the temporary directory however so
        it can be looked at after the test run has finished.

        """
        self._sys_modules_snapshot.restore()
        self._sys_path_snapshot.restore()
        self._cwd_snapshot.restore()
        self.monkeypatch.undo()
~~~

@x-symbol desc="def __take_sys_modules_snapshot(self)" file="src/_pytest/pytester.py" qual="Testdir.__take_sys_modules_snapshot" lineno=612 endline=619 refs="#src-_pytest-pytester-py--c-sysmodulessnapshot" [#src-_pytest-pytester-py--c-testdir--m-__take_sys_modules_snapshot]
~~~
    def __take_sys_modules_snapshot(self):
        # some zope modules used by twisted-related tests keep internal state
        # and can't be deleted; we had some trouble in the past with
        # `zope.interface` for example
        def preserve_module(name):
            return name.startswith("zope")

        return SysModulesSnapshot(preserve=preserve_module)
~~~

