@x-symbol desc="def test_is_setup_py_different_encoding(tmpdir, mod)" file="testing/test_doctest.py" qual="test_is_setup_py_different_encoding" lineno=1511 endline=1518 [#testing-test_doctest-py--f-test_is_setup_py_different_encoding]
~~~
def test_is_setup_py_different_encoding(tmpdir, mod):
    setup_py = tmpdir.join("setup.py")
    contents = (
        "# -*- coding: cp1252 -*-\n"
        'from {} import setup; setup(name="foo", description="€")\n'.format(mod)
    )
    setup_py.write_binary(contents.encode("cp1252"))
    assert _is_setup_py(setup_py)
~~~

