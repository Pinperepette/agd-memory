@x-symbol desc="def test_unittest_expected_failure_for_failing_test_is_xfail(testdir, runner)" file="testing/test_unittest.py" qual="test_unittest_expected_failure_for_failing_test_is_xfail" lineno=738 endline=758 [#testing-test_unittest-py--f-test_unittest_expected_failure_for_failing_test_is_xfail]
~~~
def test_unittest_expected_failure_for_failing_test_is_xfail(testdir, runner):
    script = testdir.makepyfile(
        """
        import unittest
        class MyTestCase(unittest.TestCase):
            @unittest.expectedFailure
            def test_failing_test_is_xfail(self):
                assert False
        if __name__ == '__main__':
            unittest.main()
    """
    )
    if runner == "pytest":
        result = testdir.runpytest("-rxX")
        result.stdout.fnmatch_lines(
            ["*XFAIL*MyTestCase*test_failing_test_is_xfail*", "*1 xfailed*"]
        )
    else:
        result = testdir.runpython(script)
        result.stderr.fnmatch_lines(["*1 test in*", "*OK*(expected failures=1)*"])
    assert result.ret == 0
~~~

