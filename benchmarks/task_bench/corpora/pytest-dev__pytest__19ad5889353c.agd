@x-symbol desc="class ArgumentError(Exception)" file="src/_pytest/config/argparsing.py" qual="ArgumentError" lineno=183 endline=197 [#src-_pytest-config-argparsing-py--c-argumenterror]
~~~
class ArgumentError(Exception):
    """
    Raised if an Argument instance is created with invalid or
    inconsistent arguments.
    """

    def __init__(self, msg: str, option: Union["Argument", str]) -> None:
        self.msg = msg
        self.option_id = str(option)

    def __str__(self) -> str:
        if self.option_id:
            return "option {}: {}".format(self.option_id, self.msg)
        else:
            return self.msg
~~~

