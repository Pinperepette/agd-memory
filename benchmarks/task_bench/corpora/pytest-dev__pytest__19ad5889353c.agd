def get_user() -> Optional[str]:
    """Return the current user name, or None if getuser() does not work
    in the current environment (see #1010).
    """
    import getpass

    try:
        return getpass.getuser()
    except (ImportError, KeyError):
        return None
~~~

@x-symbol desc="def pytest_configure(config)" file="src/_pytest/tmpdir.py" qual="pytest_configure" lineno=138 endline=150 refs="#src-_pytest-tmpdir-py--c-temppathfactory--m-from_config,#src-_pytest-tmpdir-py--c-tempdirfactory" [#src-_pytest-tmpdir-py--f-pytest_configure]
~~~
def pytest_configure(config) -> None:
    """Create a TempdirFactory and attach it to the config object.

    This is to comply with existing plugins which expect the handler to be
    available at pytest_configure time, but ideally should be moved entirely
    to the tmpdir_factory session fixture.
    """
    mp = MonkeyPatch()
    tmppath_handler = TempPathFactory.from_config(config)
    t = TempdirFactory(tmppath_handler)
    config._cleanup.append(mp.undo)
    mp.setattr(config, "_tmp_path_factory", tmppath_handler, raising=False)
    mp.setattr(config, "_tmpdirhandler", t, raising=False)
~~~

@x-symbol desc="def tmpdir_factory(request: FixtureRequest)" file="src/_pytest/tmpdir.py" qual="tmpdir_factory" lineno=154 endline=158 [#src-_pytest-tmpdir-py--f-tmpdir_factory]
