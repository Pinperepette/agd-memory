@x-symbol desc="class DontReadFromInput" file="src/_pytest/capture.py" qual="DontReadFromInput" lineno=212 endline=238 [#src-_pytest-capture-py--c-dontreadfrominput]
~~~
class DontReadFromInput:
    encoding = None

    def read(self, *args):
        raise OSError(
            "pytest: reading from stdin while output is captured!  Consider using `-s`."
        )

    readline = read
    readlines = read
    __next__ = read

    def __iter__(self):
        return self

    def fileno(self) -> int:
        raise UnsupportedOperation("redirected stdin is pseudofile, has no fileno()")

    def isatty(self) -> bool:
        return False

    def close(self) -> None:
        pass

    @property
    def buffer(self):
        return self
~~~

