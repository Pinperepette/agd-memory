@x-symbol desc="def compile_(source: Union[str, bytes, ast.mod, ast.AST], filename: Optional[str]=None, mode: str='exec', flags: int=0, dont_inherit: int=0)" file="src/_pytest/_code/source.py" qual="compile_" lineno=257 endline=277 refs="#src-_pytest-_code-source-py--c-source,#src-_pytest-_code-source-py--c-source--m-compile-3" [#src-_pytest-_code-source-py--f-compile_-3]
~~~
def compile_(  # noqa: F811
    source: Union[str, bytes, ast.mod, ast.AST],
    filename: Optional[str] = None,
    mode: str = "exec",
    flags: int = 0,
    dont_inherit: int = 0,
) -> Union[CodeType, ast.AST]:
    """ compile the given source to a raw code object,
        and maintain an internal cache which allows later
        retrieval of the source code for the code object
        and any recursively created code objects.
    """
    if isinstance(source, ast.AST):
        # XXX should Source support having AST?
        assert filename is not None
        co = compile(source, filename, mode, flags, dont_inherit)
        assert isinstance(co, (CodeType, ast.AST))
        return co
    _genframe = sys._getframe(1)  # the caller
    s = Source(source)
    return s.compile(filename, mode, flags, _genframe=_genframe)
~~~

@x-symbol desc="def findsource(obj)" file="src/_pytest/_code/source.py" qual="findsource" lineno=285 endline=292 refs="#src-_pytest-_code-source-py--c-source" [#src-_pytest-_code-source-py--f-findsource]
~~~
def findsource(obj) -> Tuple[Optional[Source], int]:
    try:
        sourcelines, lineno = inspect.findsource(obj)
    except Exception:
        return None, -1
    source = Source()
    source.lines = [line.rstrip() for line in sourcelines]
    return source, lineno
~~~

@x-symbol desc="def getrawcode(obj, trycall: bool=True)" file="src/_pytest/_code/source.py" qual="getrawcode" lineno=295 endline=307 [#src-_pytest-_code-source-py--f-getrawcode]
~~~
def getrawcode(obj, trycall: bool = True):
    """ return code object for given function. """
    try:
        return obj.__code__
    except AttributeError:
        obj = getattr(obj, "f_code", obj)
        obj = getattr(obj, "__code__", obj)
        if trycall and not hasattr(obj, "co_firstlineno"):
            if hasattr(obj, "__call__") and not inspect.isclass(obj):
                x = getrawcode(obj.__call__, trycall=False)
                if hasattr(x, "co_firstlineno"):
                    return x
        return obj
~~~

@x-symbol desc="def getsource(obj, **kwargs)" file="src/_pytest/_code/source.py" qual="getsource" lineno=310 endline=317 refs="#src-_pytest-_code-source-py--f-getrawcode,#src-_pytest-_code-source-py--c-source" [#src-_pytest-_code-source-py--f-getsource]
~~~
def getsource(obj, **kwargs) -> Source:
    obj = getrawcode(obj)
    try:
        strsrc = inspect.getsource(obj)
    except IndentationError:
        strsrc = '"Buggy python version consider upgrading, cannot get source"'
    assert isinstance(strsrc, str)
    return Source(strsrc, **kwargs)
~~~

