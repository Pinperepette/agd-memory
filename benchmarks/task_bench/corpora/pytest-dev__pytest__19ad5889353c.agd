@x-symbol desc="def test_orphaned_pyc_file(self, testdir)" file="testing/test_assertrewrite.py" qual="TestRewriteOnImport.test_orphaned_pyc_file" lineno=800 endline=824 [#testing-test_assertrewrite-py--c-testrewriteonimport--m-test_orphaned_pyc_file]
~~~
    def test_orphaned_pyc_file(self, testdir):
        testdir.makepyfile(
            """
            import orphan
            def test_it():
                assert orphan.value == 17
            """
        )
        testdir.makepyfile(
            orphan="""
            value = 17
            """
        )
        py_compile.compile("orphan.py")
        os.remove("orphan.py")

        # Python 3 puts the .pyc files in a __pycache__ directory, and will
        # not import from there without source.  It will import a .pyc from
        # the source location though.
        if not os.path.exists("orphan.pyc"):
            pycs = glob.glob("__pycache__/orphan.*.pyc")
            assert len(pycs) == 1
            os.rename(pycs[0], "orphan.pyc")

        assert testdir.runpytest().ret == 0
~~~

@x-symbol desc="def test_cached_pyc_includes_pytest_version(self, testdir, monkeypatch)" file="testing/test_assertrewrite.py" qual="TestRewriteOnImport.test_cached_pyc_includes_pytest_version" lineno=826 endline=842 [#testing-test_assertrewrite-py--c-testrewriteonimport--m-test_cached_pyc_includes_pytest_version]
