def test_marker_expr_eval_failure_handling(testdir, expr):
    foo = testdir.makepyfile(
        """
        import pytest

        @pytest.mark.internal_err
        def test_foo():
            pass
        """
    )
    expected = "ERROR: Wrong expression passed to '-m': {}: *".format(expr)
