@x-symbol desc="def test_parametrize_indirect_list_functional(self, testdir: Testdir)" file="testing/python/metafunc.py" qual="TestMetafunc.test_parametrize_indirect_list_functional" lineno=694 endline=721 [#testing-python-metafunc-py--c-testmetafunc--m-test_parametrize_indirect_list_functional]
~~~
    def test_parametrize_indirect_list_functional(self, testdir: Testdir) -> None:
        """
        #714
        Test parametrization with 'indirect' parameter applied on
        particular arguments. As y is is direct, its value should
        be used directly rather than being passed to the fixture
        y.

        :param testdir: the instance of Testdir class, a temporary
        test directory.
        """
        testdir.makepyfile(
            """
            import pytest
            @pytest.fixture(scope='function')
            def x(request):
                return request.param * 3
            @pytest.fixture(scope='function')
            def y(request):
                return request.param * 2
            @pytest.mark.parametrize('x, y', [('a', 'b')], indirect=['x'])
            def test_simple(x,y):
                assert len(x) == 3
                assert len(y) == 1
        """
        )
        result = testdir.runpytest("-v")
        result.stdout.fnmatch_lines(["*test_simple*a-b*", "*1 passed*"])
~~~

