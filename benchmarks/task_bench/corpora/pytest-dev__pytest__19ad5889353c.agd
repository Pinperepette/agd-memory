@x-symbol desc="def test_setinitial_conftest_subdirs(testdir, name)" file="testing/test_conftest.py" qual="test_setinitial_conftest_subdirs" lineno=163 endline=174 refs="#testing-test_conftest-py--f-conftest_setinitial" [#testing-test_conftest-py--f-test_setinitial_conftest_subdirs]
