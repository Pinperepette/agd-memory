@x-symbol desc="def get_issues()" file="extra/get_issues.py" qual="get_issues" lineno=9 endline=30 [#extra-get_issues-py--f-get_issues]
~~~
def get_issues():
    issues = []
    url = issues_url
    while 1:
        get_data = {"state": "all"}
        r = requests.get(url, params=get_data)
        data = r.json()
        if r.status_code == 403:
            # API request limit exceeded
            print(data["message"])
            exit(1)
        issues.extend(data)

        # Look for next page
        links = requests.utils.parse_header_links(r.headers["Link"])
        another_page = False
        for link in links:
            if link["rel"] == "next":
                url = link["url"]
                another_page = True
        if not another_page:
            return issues
~~~

@x-symbol desc="def main(args)" file="extra/get_issues.py" qual="main" lineno=33 endline=44 refs="#extra-get_issues-py--f-report,#extra-get_issues-py--f-get_issues" [#extra-get_issues-py--f-main]
~~~
def main(args):
    cachefile = py.path.local(args.cache)
    if not cachefile.exists() or args.refresh:
        issues = get_issues()
        cachefile.write(json.dumps(issues))
    else:
        issues = json.loads(cachefile.read())

    open_issues = [x for x in issues if x["state"] == "open"]

    open_issues.sort(key=lambda x: x["number"])
    report(open_issues)
~~~

@x-symbol desc="def _get_kind(issue)" file="extra/get_issues.py" qual="_get_kind" lineno=47 endline=52 [#extra-get_issues-py--f-_get_kind]
~~~
def _get_kind(issue):
    labels = [label["name"] for label in issue["labels"]]
    for key in ("bug", "enhancement", "proposal"):
        if key in labels:
            return key
    return "issue"
~~~

@x-symbol desc="def report(issues)" file="extra/get_issues.py" qual="report" lineno=55 endline=71 refs="#extra-get_issues-py--f-_get_kind" [#extra-get_issues-py--f-report]
~~~
def report(issues):
    for issue in issues:
        title = issue["title"]
        # body = issue["body"]
        kind = _get_kind(issue)
        status = issue["state"]
        number = issue["number"]
        link = "https://github.com/pytest-dev/pytest/issues/%s/" % number
        print("----")
        print(status, kind, link)
        print(title)
        # print()
        # lines = body.split("\n")
        # print("\n".join(lines[:3]))
        # if len(lines) > 3 or len(body) > 240:
        #    print("...")
    print("\n\nFound %s open issues" % len(issues))
~~~

