@x-symbol desc="class FDCapture(FDCaptureBinary)" file="src/_pytest/capture.py" qual="FDCapture" lineno=469 endline=488 refs="#src-_pytest-capture-py--c-fdcapturebinary--m-_assert_state,#src-_pytest-capture-py--c-dontreadfrominput--m-read,#src-_pytest-capture-py--c-fdcapture--m-writeorg" [#src-_pytest-capture-py--c-fdcapture]
~~~
class FDCapture(FDCaptureBinary):
    """Capture IO to/from a given os-level filedescriptor.

    snap() produces text
    """

    # Ignore type because it doesn't match the type in the superclass (bytes).
    EMPTY_BUFFER = ""  # type: ignore

    def snap(self):
        self._assert_state("snap", ("started", "suspended"))
        self.tmpfile.seek(0)
        res = self.tmpfile.read()
        self.tmpfile.seek(0)
        self.tmpfile.truncate()
        return res

    def writeorg(self, data):
        """ write to original file descriptor. """
        super().writeorg(data.encode("utf-8"))  # XXX use encoding of original stream
~~~

