@x-symbol desc="def test_iterable_full_diff(self, left, right, expected)" file="testing/test_assertion.py" qual="TestAssert_reprcompare.test_iterable_full_diff" lineno=430 endline=441 refs="#testing-test_assertion-py--f-callequal" [#testing-test_assertion-py--c-testassert_reprcompare--m-test_iterable_full_diff]
