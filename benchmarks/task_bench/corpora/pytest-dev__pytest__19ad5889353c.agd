    def test_timestamp_in_xml(self, testdir, run_and_parse, xunit_family):
        testdir.makepyfile(
            """
            def test_pass():
                pass
        """
        )
        start_time = datetime.now()
        result, dom = run_and_parse(family=xunit_family)
        node = dom.find_first_by_tag("testsuite")
        timestamp = datetime.strptime(node["timestamp"], "%Y-%m-%dT%H:%M:%S.%f")
        assert start_time <= timestamp < datetime.now()
~~~

@x-symbol desc="def test_timing_function(self, testdir, run_and_parse, mock_timing)" file="testing/test_junitxml.py" qual="TestPython.test_timing_function" lineno=210 endline=226 refs="#testing-test_junitxml-py--f-run_and_parse,#testing-test_junitxml-py--c-domnode--m-find_first_by_tag" [#testing-test_junitxml-py--c-testpython--m-test_timing_function]
