@x-symbol desc="def strip(self)" file="src/_pytest/_code/source.py" qual="Source.strip" lineno=63 endline=74 refs="#src-_pytest-_code-source-py--c-source" [#src-_pytest-_code-source-py--c-source--m-strip]
~~~
    def strip(self):
        """ return new source object with trailing
            and leading blank lines removed.
        """
        start, end = 0, len(self)
        while start < end and not self.lines[start].strip():
            start += 1
        while end > start and not self.lines[end - 1].strip():
            end -= 1
        source = Source()
        source.lines[:] = self.lines[start:end]
        return source
~~~

@x-symbol desc="def putaround(self, before='', after='', indent=' ' * 4)" file="src/_pytest/_code/source.py" qual="Source.putaround" lineno=76 endline=85 refs="#src-_pytest-_code-source-py--c-source" [#src-_pytest-_code-source-py--c-source--m-putaround]
~~~
    def putaround(self, before="", after="", indent=" " * 4):
        """ return a copy of the source object with
            'before' and 'after' wrapped around it.
        """
        before = Source(before)
        after = Source(after)
        newsource = Source()
        lines = [(indent + line) for line in self.lines]
        newsource.lines = before.lines + lines + after.lines
        return newsource
~~~

