@x-symbol desc="def test_fdcapture_tmpfile_remains_the_same(tmpfile, use)" file="testing/test_capture.py" qual="test_fdcapture_tmpfile_remains_the_same" lineno=1236 endline=1247 refs="#testing-test_capture-py--f-stdcapturefd" [#testing-test_capture-py--f-test_fdcapture_tmpfile_remains_the_same]
~~~
def test_fdcapture_tmpfile_remains_the_same(tmpfile, use):
    if not use:
        tmpfile = True
    cap = StdCaptureFD(out=False, err=tmpfile)
    try:
        cap.start_capturing()
        capfile = cap.err.tmpfile
        cap.readouterr()
    finally:
        cap.stop_capturing()
    capfile2 = cap.err.tmpfile
    assert capfile2 == capfile
~~~

