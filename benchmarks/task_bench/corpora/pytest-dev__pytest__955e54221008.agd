@x-symbol desc="def test_report_extra_parameters(reporttype)" file="testing/test_runner.py" qual="test_report_extra_parameters" lineno=470 endline=477 [#testing-test_runner-py--f-test_report_extra_parameters]
~~~
def test_report_extra_parameters(reporttype):
    if hasattr(inspect, "signature"):
        args = list(inspect.signature(reporttype.__init__).parameters.keys())[1:]
    else:
        args = inspect.getargspec(reporttype.__init__)[0][1:]
    basekw = dict.fromkeys(args, [])
    report = reporttype(newthing=1, **basekw)
    assert report.newthing == 1
~~~

@x-symbol desc="def test_callinfo()" file="testing/test_runner.py" qual="test_callinfo" lineno=480 endline=492 [#testing-test_runner-py--f-test_callinfo]
~~~
def test_callinfo():
    ci = runner.CallInfo.from_call(lambda: 0, "123")
    assert ci.when == "123"
    assert ci.result == 0
    assert "result" in repr(ci)
    assert repr(ci) == "<CallInfo when='123' result: 0>"

    ci = runner.CallInfo.from_call(lambda: 0 / 0, "123")
    assert ci.when == "123"
    assert not hasattr(ci, "result")
    assert repr(ci) == "<CallInfo when='123' exception: division by zero>"
    assert ci.excinfo
    assert "exc" in repr(ci)
~~~

@x-symbol desc="def test_runtest_in_module_ordering(testdir)" file="testing/test_runner.py" qual="test_runtest_in_module_ordering" lineno=500 endline=528 [#testing-test_runner-py--f-test_runtest_in_module_ordering]
~~~
def test_runtest_in_module_ordering(testdir):
    p1 = testdir.makepyfile(
        """
        import pytest
        def pytest_runtest_setup(item): # runs after class-level!
            item.function.mylist.append("module")
        class TestClass(object):
            def pytest_runtest_setup(self, item):
                assert not hasattr(item.function, 'mylist')
                item.function.mylist = ['class']
            @pytest.fixture
            def mylist(self, request):
                return request.function.mylist
            def pytest_runtest_call(self, item, __multicall__):
                try:
                    __multicall__.execute()
                except ValueError:
                    pass
            def test_hello1(self, mylist):
                assert mylist == ['class', 'module'], mylist
                raise ValueError()
            def test_hello2(self, mylist):
                assert mylist == ['class', 'module'], mylist
        def pytest_runtest_teardown(item):
            del item.function.mylist
    """
    )
    result = testdir.runpytest(p1)
    result.stdout.fnmatch_lines(["*2 passed*"])
~~~

