@x-symbol desc="def pytest_cmdline_parse(self, pluginmanager, args)" file="src/_pytest/config/__init__.py" qual="Config.pytest_cmdline_parse" lineno=718 endline=740 refs="#src-_pytest-config-__init__-py--c-config--m-parse" [#src-_pytest-config-__init__-py--c-config--m-pytest_cmdline_parse]
~~~
    def pytest_cmdline_parse(self, pluginmanager, args):
        try:
            self.parse(args)
        except UsageError:

            # Handle --version and --help here in a minimal fashion.
            # This gets done via helpconfig normally, but its
            # pytest_cmdline_main is not called in case of errors.
            if getattr(self.option, "version", False) or "--version" in args:
                from _pytest.helpconfig import showversion

                showversion(self)
            elif (
                getattr(self.option, "help", False) or "--help" in args or "-h" in args
            ):
                self._parser._getparser().print_help()
                sys.stdout.write(
                    "\nNOTE: displaying only minimal help due to UsageError.\n\n"
                )

            raise

        return self
~~~

@x-symbol desc="def notify_exception(self, excinfo, option=None)" file="src/_pytest/config/__init__.py" qual="Config.notify_exception" lineno=742 endline=754 [#src-_pytest-config-__init__-py--c-config--m-notify_exception]
~~~
    def notify_exception(self, excinfo, option=None):
        if option and getattr(option, "fulltrace", False):
            style = "long"
        else:
            style = "native"
        excrepr = excinfo.getrepr(
            funcargs=True, showlocals=getattr(option, "showlocals", False), style=style
        )
        res = self.hook.pytest_internalerror(excrepr=excrepr, excinfo=excinfo)
        if not any(res):
            for line in str(excrepr).split("\n"):
                sys.stderr.write("INTERNALERROR> %s\n" % line)
                sys.stderr.flush()
~~~

@x-symbol desc="def cwd_relative_nodeid(self, nodeid)" file="src/_pytest/config/__init__.py" qual="Config.cwd_relative_nodeid" lineno=756 endline=761 [#src-_pytest-config-__init__-py--c-config--m-cwd_relative_nodeid]
~~~
    def cwd_relative_nodeid(self, nodeid):
        # nodeid's are relative to the rootpath, compute relative to cwd
        if self.invocation_dir != self.rootdir:
            fullpath = self.rootdir.join(nodeid)
            nodeid = self.invocation_dir.bestrelpath(fullpath)
        return nodeid
~~~

@x-symbol desc="def fromdictargs(cls, option_dict, args)" file="src/_pytest/config/__init__.py" qual="Config.fromdictargs" lineno=764 endline=771 refs="#src-_pytest-config-__init__-py--f-get_config,#src-_pytest-config-__init__-py--c-config--m-parse,#src-_pytest-config-__init__-py--c-pytestpluginmanager--m-consider_pluginarg" [#src-_pytest-config-__init__-py--c-config--m-fromdictargs]
