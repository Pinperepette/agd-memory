@x-symbol desc="def test_dontreadfrominput()" file="testing/test_capture.py" qual="test_dontreadfrominput" lineno=824 endline=834 [#testing-test_capture-py--f-test_dontreadfrominput]
~~~
def test_dontreadfrominput():
    from _pytest.capture import DontReadFromInput

    f = DontReadFromInput()
    assert not f.isatty()
    pytest.raises(IOError, f.read)
    pytest.raises(IOError, f.readlines)
    iter_f = iter(f)
    pytest.raises(IOError, next, iter_f)
    pytest.raises(UnsupportedOperation, f.fileno)
    f.close()  # just for completeness
~~~

@x-symbol desc="def test_dontreadfrominput_buffer_python3()" file="testing/test_capture.py" qual="test_dontreadfrominput_buffer_python3" lineno=837 endline=848 [#testing-test_capture-py--f-test_dontreadfrominput_buffer_python3]
~~~
def test_dontreadfrominput_buffer_python3():
    from _pytest.capture import DontReadFromInput

    f = DontReadFromInput()
    fb = f.buffer
    assert not fb.isatty()
    pytest.raises(IOError, fb.read)
    pytest.raises(IOError, fb.readlines)
    iter_f = iter(f)
    pytest.raises(IOError, next, iter_f)
    pytest.raises(ValueError, fb.fileno)
    f.close()  # just for completeness
~~~

