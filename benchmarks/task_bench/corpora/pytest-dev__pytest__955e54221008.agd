@x-symbol desc="def _write_pyc(state, co, source_stat, pyc)" file="src/_pytest/assertion/rewrite.py" qual="_write_pyc" lineno=253 endline=272 [#src-_pytest-assertion-rewrite-py--f-_write_pyc]
~~~
def _write_pyc(state, co, source_stat, pyc):
    # Technically, we don't have to have the same pyc format as
    # (C)Python, since these "pycs" should never be seen by builtin
    # import. However, there's little reason deviate.
    try:
        with atomicwrites.atomic_write(pyc, mode="wb", overwrite=True) as fp:
            fp.write(importlib.util.MAGIC_NUMBER)
            # as of now, bytecode header expects 32-bit numbers for size and mtime (#4903)
            mtime = int(source_stat.st_mtime) & 0xFFFFFFFF
            size = source_stat.st_size & 0xFFFFFFFF
            # "<LL" stands for 2 unsigned longs, little-ending
            fp.write(struct.pack("<LL", mtime, size))
            fp.write(marshal.dumps(co))
    except EnvironmentError as e:
        state.trace("error writing pyc file at {}: errno={}".format(pyc, e.errno))
        # we ignore any failure to write the cache file
        # there are many reasons, permission-denied, __pycache__ being a
        # file etc.
        return False
    return True
~~~

@x-symbol desc="def _rewrite_test(fn, config)" file="src/_pytest/assertion/rewrite.py" qual="_rewrite_test" lineno=275 endline=283 refs="#src-_pytest-assertion-rewrite-py--f-rewrite_asserts" [#src-_pytest-assertion-rewrite-py--f-_rewrite_test]
~~~
def _rewrite_test(fn, config):
    """read and rewrite *fn* and return the code object."""
    stat = os.stat(fn)
    with open(fn, "rb") as f:
        source = f.read()
    tree = ast.parse(source, filename=fn)
    rewrite_asserts(tree, source, fn, config)
    co = compile(tree, fn, "exec", dont_inherit=True)
    return stat, co
~~~

@x-symbol desc="def _read_pyc(source, pyc, trace=lambda x: None)" file="src/_pytest/assertion/rewrite.py" qual="_read_pyc" lineno=286 endline=320 [#src-_pytest-assertion-rewrite-py--f-_read_pyc]
~~~
def _read_pyc(source, pyc, trace=lambda x: None):
    """Possibly read a pytest pyc containing rewritten code.

    Return rewritten code if successful or None if not.
    """
    try:
        fp = open(pyc, "rb")
    except IOError:
        return None
    with fp:
        try:
            stat_result = os.stat(source)
            mtime = int(stat_result.st_mtime)
            size = stat_result.st_size
            data = fp.read(12)
        except EnvironmentError as e:
            trace("_read_pyc({}): EnvironmentError {}".format(source, e))
            return None
        # Check for invalid or out of date pyc file.
        if (
            len(data) != 12
            or data[:4] != importlib.util.MAGIC_NUMBER
            or struct.unpack("<LL", data[4:]) != (mtime & 0xFFFFFFFF, size & 0xFFFFFFFF)
        ):
            trace("_read_pyc(%s): invalid or out of date pyc" % source)
            return None
        try:
            co = marshal.load(fp)
        except Exception as e:
            trace("_read_pyc({}): marshal.load error {}".format(source, e))
            return None
        if not isinstance(co, types.CodeType):
            trace("_read_pyc(%s): not a code object" % source)
            return None
        return co
~~~

@x-symbol desc="def rewrite_asserts(mod, source, module_path=None, config=None)" file="src/_pytest/assertion/rewrite.py" qual="rewrite_asserts" lineno=323 endline=325 refs="#src-_pytest-assertion-rewrite-py--c-assertionrewriter--m-run,#src-_pytest-assertion-rewrite-py--c-assertionrewriter" [#src-_pytest-assertion-rewrite-py--f-rewrite_asserts]
~~~
def rewrite_asserts(mod, source, module_path=None, config=None):
    """Rewrite the assert statements in mod."""
    AssertionRewriter(module_path, config, source).run(mod)
~~~

@x-symbol desc="def _saferepr(obj)" file="src/_pytest/assertion/rewrite.py" qual="_saferepr" lineno=328 endline=339 [#src-_pytest-assertion-rewrite-py--f-_saferepr]
~~~
def _saferepr(obj):
    """Get a safe repr of an object for assertion error messages.

    The assertion formatting (util.format_explanation()) requires
    newlines to be escaped since they are a special character for it.
    Normally assertion.util.format_explanation() does this but for a
    custom repr it is possible to contain one of the special escape
    sequences, especially '\n{' and '\n}' are likely to be present in
    JSON reprs.

    """
    return saferepr(obj).replace("\n", "\\n")
~~~

@x-symbol desc="def _format_assertmsg(obj)" file="src/_pytest/assertion/rewrite.py" qual="_format_assertmsg" lineno=342 endline=362 [#src-_pytest-assertion-rewrite-py--f-_format_assertmsg]
~~~
def _format_assertmsg(obj):
    """Format the custom assertion message given.

    For strings this simply replaces newlines with '\n~' so that
    util.format_explanation() will preserve them instead of escaping
    newlines.  For other objects saferepr() is used first.

    """
    # reprlib appears to have a bug which means that if a string
    # contains a newline it gets escaped, however if an object has a
    # .__repr__() which contains newlines it does not get escaped.
    # However in either case we want to preserve the newline.
    replaces = [("\n", "\n~"), ("%", "%%")]
    if not isinstance(obj, str):
        obj = saferepr(obj)
        replaces.append(("\\n", "\n~"))

    for r1, r2 in replaces:
        obj = obj.replace(r1, r2)

    return obj
~~~

@x-symbol desc="def _should_repr_global_name(obj)" file="src/_pytest/assertion/rewrite.py" qual="_should_repr_global_name" lineno=365 endline=372 [#src-_pytest-assertion-rewrite-py--f-_should_repr_global_name]
~~~
def _should_repr_global_name(obj):
    if callable(obj):
        return False

    try:
        return not hasattr(obj, "__name__")
    except Exception:
        return True
~~~

@x-symbol desc="def _format_boolop(explanations, is_or)" file="src/_pytest/assertion/rewrite.py" qual="_format_boolop" lineno=375 endline=380 [#src-_pytest-assertion-rewrite-py--f-_format_boolop]
~~~
def _format_boolop(explanations, is_or):
    explanation = "(" + (is_or and " or " or " and ").join(explanations) + ")"
    if isinstance(explanation, str):
        return explanation.replace("%", "%%")
    else:
        return explanation.replace(b"%", b"%%")
~~~

@x-symbol desc="def _call_reprcompare(ops, results, expls, each_obj)" file="src/_pytest/assertion/rewrite.py" qual="_call_reprcompare" lineno=383 endline=395 [#src-_pytest-assertion-rewrite-py--f-_call_reprcompare]
~~~
def _call_reprcompare(ops, results, expls, each_obj):
    for i, res, expl in zip(range(len(ops)), results, expls):
        try:
            done = not res
        except Exception:
            done = True
        if done:
            break
    if util._reprcompare is not None:
        custom = util._reprcompare(ops[i], each_obj[i], each_obj[i + 1])
        if custom is not None:
            return custom
    return expl
~~~

