@x-symbol desc="def _call_with_optional_argument(func, arg)" file="src/_pytest/python.py" qual="_call_with_optional_argument" lineno=661 endline=670 [#src-_pytest-python-py--f-_call_with_optional_argument]
~~~
def _call_with_optional_argument(func, arg):
    """Call the given function with the given argument if func accepts one argument, otherwise
    calls func without arguments"""
    arg_count = func.__code__.co_argcount
    if inspect.ismethod(func):
        arg_count -= 1
    if arg_count:
        func(arg)
    else:
        func()
~~~

@x-symbol desc="def _get_first_non_fixture_func(obj, names)" file="src/_pytest/python.py" qual="_get_first_non_fixture_func" lineno=673 endline=681 [#src-_pytest-python-py--f-_get_first_non_fixture_func]
~~~
def _get_first_non_fixture_func(obj, names):
    """Return the attribute from the given object to be used as a setup/teardown
    xunit-style function, but only if not marked as a fixture to
    avoid calling it twice.
    """
    for name in names:
        meth = getattr(obj, name, None)
