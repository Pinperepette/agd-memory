@x-symbol desc="class PercentStyleMultiline(logging.PercentStyle)" file="src/_pytest/logging.py" qual="PercentStyleMultiline" lineno=68 endline=92 refs="#src-_pytest-logging-py--c-percentstylemultiline--m-_update_message,#src-_pytest-logging-py--f-_remove_ansi_escape_sequences" [#src-_pytest-logging-py--c-percentstylemultiline]
~~~
class PercentStyleMultiline(logging.PercentStyle):
    """A logging style with special support for multiline messages.

    If the message of a record consists of multiple lines, this style
    formats the message as if each line were logged separately.
    """

    @staticmethod
    def _update_message(record_dict, message):
        tmp = record_dict.copy()
        tmp["message"] = message
        return tmp

    def format(self, record):
        if "\n" in record.message:
            lines = record.message.splitlines()
            formatted = self._fmt % self._update_message(record.__dict__, lines[0])
            # TODO optimize this by introducing an option that tells the
            # logging framework that the indentation doesn't
            # change. This allows to compute the indentation only once.
            indentation = _remove_ansi_escape_sequences(formatted).find(lines[0])
            lines[0] = formatted
            return ("\n" + " " * indentation).join(lines)
        else:
            return self._fmt % record.__dict__
~~~

