def pytest_collection(session):
    config = session.config
    with catch_warnings_for_item(
        config=config, ihook=config.hook, when="collect", item=None
    ):
        yield
~~~

@x-symbol desc="def pytest_terminal_summary(terminalreporter)" file="src/_pytest/warnings.py" qual="pytest_terminal_summary" lineno=127 endline=132 refs="#src-_pytest-warnings-py--f-catch_warnings_for_item" [#src-_pytest-warnings-py--f-pytest_terminal_summary]
