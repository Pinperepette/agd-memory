@x-symbol desc="def _ensure_only_one_capture_fixture(request, name)" file="src/_pytest/capture.py" qual="_ensure_only_one_capture_fixture" lineno=244 endline=251 [#src-_pytest-capture-py--f-_ensure_only_one_capture_fixture]
~~~
def _ensure_only_one_capture_fixture(request, name):
    fixtures = set(request.fixturenames) & capture_fixtures - {name}
    if fixtures:
        fixtures = sorted(fixtures)
        fixtures = fixtures[0] if len(fixtures) == 1 else fixtures
        raise request.raiseerror(
            "cannot use {} and {} at the same time".format(fixtures, name)
        )
~~~

