@x-symbol desc="def longreprtext(self)" file="src/_pytest/reports.py" qual="BaseReport.longreprtext" lineno=60 endline=71 refs="#src-_pytest-reports-py--c-collecterrorrepr--m-toterminal" [#src-_pytest-reports-py--c-basereport--m-longreprtext]
~~~
    def longreprtext(self):
        """
        Read-only property that returns the full string representation
        of ``longrepr``.

        .. versionadded:: 3.0
        """
        tw = py.io.TerminalWriter(stringio=True)
        tw.hasmarkup = False
        self.toterminal(tw)
        exc = tw.stringio.getvalue()
        return exc.strip()
~~~

