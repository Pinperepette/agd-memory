@x-symbol desc="def test_comparisons(self)" file="testing/test_assertrewrite.py" qual="TestAssertionRewrite.test_comparisons" lineno=577 endline=607 refs="#testing-test_assertrewrite-py--f-getmsg" [#testing-test_assertrewrite-py--c-testassertionrewrite--m-test_comparisons]
~~~
    def test_comparisons(self):
        def f():
            a, b = range(2)
            assert b < a

        assert getmsg(f) == """assert 1 < 0"""

        def f():
            a, b, c = range(3)
            assert a > b > c

        assert getmsg(f) == """assert 0 > 1"""

        def f():
            a, b, c = range(3)
            assert a < b > c

        assert getmsg(f) == """assert 1 > 2"""

        def f():
            a, b, c = range(3)
            assert a < b <= c

        getmsg(f, must_pass=True)

        def f():
            a, b, c = range(3)
            assert a < b
            assert b < c

        getmsg(f, must_pass=True)
~~~

