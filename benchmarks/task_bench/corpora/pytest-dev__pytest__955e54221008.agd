@x-symbol desc="class ReprFuncArgs(TerminalRepr)" file="src/_pytest/_code/code.py" qual="ReprFuncArgs" lineno=1016 endline=1036 [#src-_pytest-_code-code-py--c-reprfuncargs]
~~~
class ReprFuncArgs(TerminalRepr):
    def __init__(self, args):
        self.args = args

    def toterminal(self, tw):
        if self.args:
            linesofar = ""
            for name, value in self.args:
                ns = "{} = {}".format(name, value)
                if len(ns) + len(linesofar) + 2 > tw.fullwidth:
                    if linesofar:
                        tw.line(linesofar)
                    linesofar = ns
                else:
                    if linesofar:
                        linesofar += ", " + ns
                    else:
                        linesofar = ns
            if linesofar:
                tw.line(linesofar)
            tw.line("")
~~~

