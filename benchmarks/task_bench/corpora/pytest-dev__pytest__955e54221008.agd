@x-symbol desc="def test_unittest_setup_interaction(testdir, fix_type, stmt)" file="testing/test_unittest.py" qual="test_unittest_setup_interaction" lineno=777 endline=806 [#testing-test_unittest-py--f-test_unittest_setup_interaction]
~~~
def test_unittest_setup_interaction(testdir, fix_type, stmt):
    testdir.makepyfile(
        """
        import unittest
        import pytest
        class MyTestCase(unittest.TestCase):
            @pytest.{fix_type}(scope="class", autouse=True)
            def perclass(self, request):
                request.cls.hello = "world"
                {stmt}
            @pytest.{fix_type}(scope="function", autouse=True)
            def perfunction(self, request):
                request.instance.funcname = request.function.__name__
                {stmt}

            def test_method1(self):
                assert self.funcname == "test_method1"
                assert self.hello == "world"

            def test_method2(self):
                assert self.funcname == "test_method2"

            def test_classattr(self):
                assert self.__class__.hello == "world"
    """.format(
            fix_type=fix_type, stmt=stmt
        )
    )
    result = testdir.runpytest()
    result.stdout.fnmatch_lines(["*3 passed*"])
~~~

