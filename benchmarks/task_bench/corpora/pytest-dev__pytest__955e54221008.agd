@x-symbol desc="def test_traceback_short_no_source(self, importasmod, monkeypatch)" file="testing/code/test_excinfo.py" qual="TestFormattedExcinfo.test_traceback_short_no_source" lineno=773 endline=797 refs="#testing-code-test_excinfo-py--c-testformattedexcinfo--m-importasmod" [#testing-code-test_excinfo-py--c-testformattedexcinfo--m-test_traceback_short_no_source]
