@x-symbol desc="def _format_repr_exception(exc, obj)" file="src/_pytest/_io/saferepr.py" qual="_format_repr_exception" lineno=5 endline=13 [#src-_pytest-_io-saferepr-py--f-_format_repr_exception]
~~~
def _format_repr_exception(exc, obj):
    exc_name = type(exc).__name__
    try:
        exc_info = str(exc)
    except Exception:
        exc_info = "unknown"
    return '<[{}("{}") raised in repr()] {} object at 0x{:x}>'.format(
        exc_name, exc_info, obj.__class__.__name__, id(obj)
    )
~~~

@x-symbol desc="def _ellipsize(s, maxsize)" file="src/_pytest/_io/saferepr.py" qual="_ellipsize" lineno=16 endline=21 [#src-_pytest-_io-saferepr-py--f-_ellipsize]
~~~
def _ellipsize(s, maxsize):
    if len(s) > maxsize:
        i = max(0, (maxsize - 3) // 2)
        j = max(0, maxsize - 3 - i)
        return s[:i] + "..." + s[len(s) - j :]
    return s
~~~

@x-symbol desc="class SafeRepr(reprlib.Repr)" file="src/_pytest/_io/saferepr.py" qual="SafeRepr" lineno=24 endline=46 refs="#src-_pytest-_io-saferepr-py--c-saferepr--m-__init__,#src-_pytest-_io-saferepr-py--f-_ellipsize,#src-_pytest-_io-saferepr-py--c-saferepr--m-repr,#src-_pytest-_io-saferepr-py--f-_format_repr_exception" [#src-_pytest-_io-saferepr-py--c-saferepr]
~~~
class SafeRepr(reprlib.Repr):
    """subclass of repr.Repr that limits the resulting size of repr()
    and includes information on exceptions raised during the call.
    """

    def __init__(self, maxsize):
        super().__init__()
        self.maxstring = maxsize
        self.maxsize = maxsize

    def repr(self, x):
        try:
            s = super().repr(x)
        except Exception as exc:
            s = _format_repr_exception(exc, x)
        return _ellipsize(s, self.maxsize)

    def repr_instance(self, x, level):
        try:
            s = repr(x)
        except Exception as exc:
            s = _format_repr_exception(exc, x)
        return _ellipsize(s, self.maxsize)
~~~

