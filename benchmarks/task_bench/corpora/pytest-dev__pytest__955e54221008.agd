@x-symbol desc="def _makefile(self, ext, args, kwargs, encoding='utf-8')" file="src/_pytest/pytester.py" qual="Testdir._makefile" lineno=542 endline=562 refs="#src-_pytest-pytester-py--c-linematcher--m-str" [#src-_pytest-pytester-py--c-testdir--m-_makefile]
~~~
    def _makefile(self, ext, args, kwargs, encoding="utf-8"):
        items = list(kwargs.items())

        def to_text(s):
            return s.decode(encoding) if isinstance(s, bytes) else str(s)

        if args:
            source = "\n".join(to_text(x) for x in args)
            basename = self.request.function.__name__
            items.insert(0, (basename, source))

        ret = None
        for basename, value in items:
            p = self.tmpdir.join(basename).new(ext=ext)
            p.dirpath().ensure_dir()
            source = Source(value)
            source = "\n".join(to_text(line) for line in source.lines)
            p.write(source.strip().encode(encoding), "wb")
            if ret is None:
                ret = p
        return ret
~~~

@x-symbol desc="def makefile(self, ext, *args, **kwargs)" file="src/_pytest/pytester.py" qual="Testdir.makefile" lineno=564 endline=583 refs="#src-_pytest-pytester-py--c-testdir--m-_makefile" [#src-_pytest-pytester-py--c-testdir--m-makefile]
