        @attr.s
        class DefinitionMock:
            obj = attr.ib()

        names = fixtures.getfuncargnames(func)
        fixtureinfo = FixtureInfo(names)
        definition = DefinitionMock(func)
        return python.Metafunc(definition, fixtureinfo, config)
