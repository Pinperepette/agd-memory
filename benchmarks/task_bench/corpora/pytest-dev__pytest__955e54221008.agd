@x-symbol desc="def pre_release(version)" file="scripts/release.py" qual="pre_release" lineno=82 endline=95 refs="#scripts-release-py--f-announce,#scripts-release-py--f-regen,#scripts-release-py--f-changelog,#scripts-release-py--f-fix_formatting" [#scripts-release-py--f-pre_release]
~~~
def pre_release(version):
    """Generates new docs, release announcements and creates a local tag."""
    announce(version)
    regen()
    changelog(version, write_out=True)
    fix_formatting()

    msg = "Preparing release version {}".format(version)
    check_call(["git", "commit", "-a", "-m", msg])

    print()
    print(f"{Fore.CYAN}[generate.pre_release] {Fore.GREEN}All done!")
    print()
    print(f"Please push your branch and open a PR.")
~~~

