@x-symbol desc="class YamlFile(pytest.File)" file="doc/en/example/nonpython/conftest.py" qual="YamlFile" lineno=10 endline=16 refs="#doc-en-example-nonpython-conftest-py--c-yamlitem" [#doc-en-example-nonpython-conftest-py--c-yamlfile]
~~~
class YamlFile(pytest.File):
    def collect(self):
        import yaml  # we need a yaml parser, e.g. PyYAML

        raw = yaml.safe_load(self.fspath.open())
        for name, spec in sorted(raw.items()):
            yield YamlItem(name, self, spec)
~~~

