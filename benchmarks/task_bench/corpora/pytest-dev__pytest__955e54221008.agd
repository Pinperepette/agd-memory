@x-symbol desc="def test_capturing_unicode(testdir, method)" file="testing/test_capture.py" qual="test_capturing_unicode" lineno=93 endline=108 [#testing-test_capture-py--f-test_capturing_unicode]
~~~
def test_capturing_unicode(testdir, method):
    if hasattr(sys, "pypy_version_info") and sys.pypy_version_info < (2, 2):
        pytest.xfail("does not work on pypy < 2.2")
    obj = "'b\u00f6y'"
    testdir.makepyfile(
        """\
        # taken from issue 227 from nosetests
        def test_unicode():
            import sys
            print(sys.stdout)
            print(%s)
        """
        % obj
    )
    result = testdir.runpytest("--capture=%s" % method)
    result.stdout.fnmatch_lines(["*1 passed*"])
~~~

