@x-symbol desc="def pytest_fixture_setup(fixturedef, request)" file="src/_pytest/setuponly.py" qual="pytest_fixture_setup" lineno=23 endline=37 refs="#src-_pytest-setuponly-py--f-_show_fixture_action" [#src-_pytest-setuponly-py--f-pytest_fixture_setup]
~~~
def pytest_fixture_setup(fixturedef, request):
    yield
    config = request.config
    if config.option.setupshow:
        if hasattr(request, "param"):
            # Save the fixture parameter so ._show_fixture_action() can
            # display it now and during the teardown (in .finish()).
            if fixturedef.ids:
                if callable(fixturedef.ids):
                    fixturedef.cached_param = fixturedef.ids(request.param)
                else:
                    fixturedef.cached_param = fixturedef.ids[request.param_index]
            else:
                fixturedef.cached_param = request.param
        _show_fixture_action(fixturedef, "SETUP")
~~~

@x-symbol desc="def pytest_fixture_post_finalizer(fixturedef)" file="src/_pytest/setuponly.py" qual="pytest_fixture_post_finalizer" lineno=40 endline=46 refs="#src-_pytest-setuponly-py--f-_show_fixture_action" [#src-_pytest-setuponly-py--f-pytest_fixture_post_finalizer]
~~~
def pytest_fixture_post_finalizer(fixturedef):
    if hasattr(fixturedef, "cached_result"):
        config = fixturedef._fixturemanager.config
        if config.option.setupshow:
            _show_fixture_action(fixturedef, "TEARDOWN")
            if hasattr(fixturedef, "cached_param"):
                del fixturedef.cached_param
~~~

@x-symbol desc="def _show_fixture_action(fixturedef, msg)" file="src/_pytest/setuponly.py" qual="_show_fixture_action" lineno=49 endline=78 [#src-_pytest-setuponly-py--f-_show_fixture_action]
~~~
def _show_fixture_action(fixturedef, msg):
    config = fixturedef._fixturemanager.config
    capman = config.pluginmanager.getplugin("capturemanager")
    if capman:
        capman.suspend_global_capture()
        out, err = capman.read_global_capture()

    tw = config.get_terminal_writer()
    tw.line()
    tw.write(" " * 2 * fixturedef.scopenum)
    tw.write(
        "{step} {scope} {fixture}".format(
            step=msg.ljust(8),  # align the output to TEARDOWN
            scope=fixturedef.scope[0].upper(),
            fixture=fixturedef.argname,
        )
    )

    if msg == "SETUP":
        deps = sorted(arg for arg in fixturedef.argnames if arg != "request")
        if deps:
            tw.write(" (fixtures used: {})".format(", ".join(deps)))

    if hasattr(fixturedef, "cached_param"):
        tw.write("[{}]".format(fixturedef.cached_param))

    if capman:
        capman.resume_global_capture()
        sys.stdout.write(out)
        sys.stderr.write(err)
~~~

