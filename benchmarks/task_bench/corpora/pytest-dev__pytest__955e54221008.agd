@x-symbol desc="def _ensure_unconfigure(self)" file="src/_pytest/config/__init__.py" qual="Config._ensure_unconfigure" lineno=706 endline=713 [#src-_pytest-config-__init__-py--c-config--m-_ensure_unconfigure]
