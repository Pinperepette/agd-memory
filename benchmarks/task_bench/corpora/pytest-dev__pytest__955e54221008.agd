@x-symbol desc="def _callfinalizers(self, colitem)" file="src/_pytest/runner.py" qual="SetupState._callfinalizers" lineno=291 endline=305 [#src-_pytest-runner-py--c-setupstate--m-_callfinalizers]
~~~
    def _callfinalizers(self, colitem):
        finalizers = self._finalizers.pop(colitem, None)
        exc = None
        while finalizers:
            fin = finalizers.pop()
            try:
                fin()
            except TEST_OUTCOME:
                # XXX Only first exception will be seen by user,
                #     ideally all should be reported.
                if exc is None:
                    exc = sys.exc_info()
        if exc:
            _, val, tb = exc
            raise val.with_traceback(tb)
~~~

@x-symbol desc="def _teardown_with_finalization(self, colitem)" file="src/_pytest/runner.py" qual="SetupState._teardown_with_finalization" lineno=307 endline=311 refs="#src-_pytest-runner-py--c-setupstate--m-_callfinalizers" [#src-_pytest-runner-py--c-setupstate--m-_teardown_with_finalization]
~~~
    def _teardown_with_finalization(self, colitem):
        self._callfinalizers(colitem)
        colitem.teardown()
        for colitem in self._finalizers:
            assert colitem in self.stack
~~~

@x-symbol desc="def teardown_all(self)" file="src/_pytest/runner.py" qual="SetupState.teardown_all" lineno=313 endline=318 refs="#src-_pytest-runner-py--c-setupstate--m-_pop_and_teardown,#src-_pytest-runner-py--c-setupstate--m-_teardown_with_finalization" [#src-_pytest-runner-py--c-setupstate--m-teardown_all]
~~~
    def teardown_all(self):
        while self.stack:
            self._pop_and_teardown()
        for key in list(self._finalizers):
            self._teardown_with_finalization(key)
        assert not self._finalizers
~~~

