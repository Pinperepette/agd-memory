@x-symbol desc="def _get_flag_lookup()" file="src/_pytest/doctest.py" qual="_get_flag_lookup" lineno=278 endline=291 refs="#src-_pytest-doctest-py--f-_get_allow_unicode_flag,#src-_pytest-doctest-py--f-_get_allow_bytes_flag,#src-_pytest-doctest-py--f-_get_number_flag" [#src-_pytest-doctest-py--f-_get_flag_lookup]
~~~
def _get_flag_lookup():
    import doctest

    return dict(
        DONT_ACCEPT_TRUE_FOR_1=doctest.DONT_ACCEPT_TRUE_FOR_1,
        DONT_ACCEPT_BLANKLINE=doctest.DONT_ACCEPT_BLANKLINE,
        NORMALIZE_WHITESPACE=doctest.NORMALIZE_WHITESPACE,
        ELLIPSIS=doctest.ELLIPSIS,
        IGNORE_EXCEPTION_DETAIL=doctest.IGNORE_EXCEPTION_DETAIL,
        COMPARISON_FLAGS=doctest.COMPARISON_FLAGS,
        ALLOW_UNICODE=_get_allow_unicode_flag(),
        ALLOW_BYTES=_get_allow_bytes_flag(),
        NUMBER=_get_number_flag(),
    )
~~~

@x-symbol desc="def get_optionflags(parent)" file="src/_pytest/doctest.py" qual="get_optionflags" lineno=294 endline=300 refs="#src-_pytest-doctest-py--f-_get_flag_lookup" [#src-_pytest-doctest-py--f-get_optionflags]
~~~
def get_optionflags(parent):
    optionflags_str = parent.config.getini("doctest_optionflags")
    flag_lookup_table = _get_flag_lookup()
    flag_acc = 0
    for flag in optionflags_str:
        flag_acc |= flag_lookup_table[flag]
    return flag_acc
~~~

@x-symbol desc="def _get_continue_on_failure(config)" file="src/_pytest/doctest.py" qual="_get_continue_on_failure" lineno=303 endline=310 [#src-_pytest-doctest-py--f-_get_continue_on_failure]
~~~
def _get_continue_on_failure(config):
    continue_on_failure = config.getvalue("doctest_continue_on_failure")
    if continue_on_failure:
        # We need to turn off this if we use pdb since we should stop at
        # the first failure
        if config.getvalue("usepdb"):
            continue_on_failure = False
    return continue_on_failure
~~~

@x-symbol desc="class DoctestTextfile(pytest.Module)" file="src/_pytest/doctest.py" qual="DoctestTextfile" lineno=313 endline=339 refs="#src-_pytest-doctest-py--f-get_optionflags,#src-_pytest-doctest-py--f-_get_runner,#src-_pytest-doctest-py--f-_get_checker,#src-_pytest-doctest-py--f-_get_continue_on_failure,#src-_pytest-doctest-py--c-doctestitem" [#src-_pytest-doctest-py--c-doctesttextfile]
~~~
class DoctestTextfile(pytest.Module):
    obj = None

    def collect(self):
        import doctest

        # inspired by doctest.testfile; ideally we would use it directly,
        # but it doesn't support passing a custom checker
        encoding = self.config.getini("doctest_encoding")
        text = self.fspath.read_text(encoding)
        filename = str(self.fspath)
        name = self.fspath.basename
        globs = {"__name__": "__main__"}

        optionflags = get_optionflags(self)

        runner = _get_runner(
            verbose=0,
            optionflags=optionflags,
            checker=_get_checker(),
            continue_on_failure=_get_continue_on_failure(self.config),
        )

        parser = doctest.DocTestParser()
        test = parser.get_doctest(text, globs, name, filename, 0)
        if test.examples:
            yield DoctestItem(test.name, self, runner, test)
~~~

@x-symbol desc="def collect(self)" file="src/_pytest/doctest.py" qual="DoctestTextfile.collect" lineno=316 endline=339 refs="#src-_pytest-doctest-py--f-get_optionflags,#src-_pytest-doctest-py--f-_get_runner,#src-_pytest-doctest-py--f-_get_checker,#src-_pytest-doctest-py--f-_get_continue_on_failure,#src-_pytest-doctest-py--c-doctestitem" [#src-_pytest-doctest-py--c-doctesttextfile--m-collect]
