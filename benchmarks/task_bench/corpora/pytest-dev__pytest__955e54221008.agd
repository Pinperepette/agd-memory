@x-symbol desc="def test_nullbyte(testdir)" file="testing/test_junitxml.py" qual="test_nullbyte" lineno=850 endline=865 [#testing-test_junitxml-py--f-test_nullbyte]
~~~
def test_nullbyte(testdir):
    # A null byte can not occur in XML (see section 2.2 of the spec)
    testdir.makepyfile(
        """
        import sys
        def test_print_nullbyte():
            sys.stdout.write('Here the null -->' + chr(0) + '<--')
            sys.stdout.write('In repr form -->' + repr(chr(0)) + '<--')
            assert False
    """
    )
    xmlf = testdir.tmpdir.join("junit.xml")
    testdir.runpytest("--junitxml=%s" % xmlf)
    text = xmlf.read()
    assert "\x00" not in text
    assert "#x00" in text
~~~

@x-symbol desc="def test_nullbyte_replace(testdir)" file="testing/test_junitxml.py" qual="test_nullbyte_replace" lineno=868 endline=882 [#testing-test_junitxml-py--f-test_nullbyte_replace]
