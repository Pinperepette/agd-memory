@x-symbol desc="def test_doctest_mock_objects_dont_recurse_missbehaved(mock_module, testdir)" file="testing/test_doctest.py" qual="test_doctest_mock_objects_dont_recurse_missbehaved" lineno=1363 endline=1378 [#testing-test_doctest-py--f-test_doctest_mock_objects_dont_recurse_missbehaved]
~~~
def test_doctest_mock_objects_dont_recurse_missbehaved(mock_module, testdir):
    pytest.importorskip(mock_module)
    testdir.makepyfile(
        """
        from {mock_module} import call
        class Example(object):
            '''
            >>> 1 + 1
            2
            '''
        """.format(
            mock_module=mock_module
        )
    )
    result = testdir.runpytest("--doctest-modules")
