    def test_function_equality(self, testdir, tmpdir):
        def func1():
            pass

        def func2():
            pass

        f1 = self.make_function(testdir, name="name", args=(1,), callobj=func1)
        assert f1 == f1
        f2 = self.make_function(testdir, name="name", callobj=func2)
        assert f1 != f2
