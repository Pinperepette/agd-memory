@x-symbol desc="def test_fixture_excinfo_leak(self, testdir)" file="testing/python/fixtures.py" qual="TestFillFixtures.test_fixture_excinfo_leak" lineno=459 endline=481 [#testing-python-fixtures-py--c-testfillfixtures--m-test_fixture_excinfo_leak]
~~~
    def test_fixture_excinfo_leak(self, testdir):
        # on python2 sys.excinfo would leak into fixture executions
        testdir.makepyfile(
            """
            import sys
            import traceback
            import pytest

            @pytest.fixture
            def leak():
                if sys.exc_info()[0]:  # python3 bug :)
                    traceback.print_exc()
                #fails
                assert sys.exc_info() == (None, None, None)

            def test_leak(leak):
                if sys.exc_info()[0]:  # python3 bug :)
                    traceback.print_exc()
                assert sys.exc_info() == (None, None, None)
        """
        )
        result = testdir.runpytest()
        assert result.ret == 0
~~~

@x-symbol desc="class TestRequestBasic" file="testing/python/fixtures.py" qual="TestRequestBasic" lineno=484 endline=929 [#testing-python-fixtures-py--c-testrequestbasic]
