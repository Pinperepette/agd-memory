@x-symbol desc="def test_collection_collect_only_live_logging(testdir, verbose)" file="testing/logging/test_reporting.py" qual="test_collection_collect_only_live_logging" lineno=924 endline=956 [#testing-logging-test_reporting-py--f-test_collection_collect_only_live_logging]
~~~
def test_collection_collect_only_live_logging(testdir, verbose):
    testdir.makepyfile(
        """
        def test_simple():
            pass
    """
    )

    result = testdir.runpytest("--collect-only", "--log-cli-level=INFO", verbose)

    expected_lines = []

    if not verbose:
        expected_lines.extend(
            [
                "*collected 1 item*",
                "*<Module test_collection_collect_only_live_logging.py>*",
                "*no tests ran*",
            ]
        )
    elif verbose == "-q":
        assert "collected 1 item*" not in result.stdout.str()
        expected_lines.extend(
            [
                "*test_collection_collect_only_live_logging.py::test_simple*",
                "no tests ran in 0.[0-9][0-9]s",
            ]
        )
    elif verbose == "-qq":
        assert "collected 1 item*" not in result.stdout.str()
        expected_lines.extend(["*test_collection_collect_only_live_logging.py: 1*"])

    result.stdout.fnmatch_lines(expected_lines)
~~~

