@x-symbol desc="def test_setup_only_available_in_subdir(testdir)" file="testing/python/collect.py" qual="test_setup_only_available_in_subdir" lineno=846 endline=878 [#testing-python-collect-py--f-test_setup_only_available_in_subdir]
~~~
def test_setup_only_available_in_subdir(testdir):
    sub1 = testdir.mkpydir("sub1")
    sub2 = testdir.mkpydir("sub2")
    sub1.join("conftest.py").write(
        textwrap.dedent(
            """\
            import pytest
            def pytest_runtest_setup(item):
                assert item.fspath.purebasename == "test_in_sub1"
            def pytest_runtest_call(item):
                assert item.fspath.purebasename == "test_in_sub1"
            def pytest_runtest_teardown(item):
                assert item.fspath.purebasename == "test_in_sub1"
            """
        )
    )
    sub2.join("conftest.py").write(
        textwrap.dedent(
            """\
            import pytest
            def pytest_runtest_setup(item):
                assert item.fspath.purebasename == "test_in_sub2"
            def pytest_runtest_call(item):
                assert item.fspath.purebasename == "test_in_sub2"
            def pytest_runtest_teardown(item):
                assert item.fspath.purebasename == "test_in_sub2"
            """
        )
    )
    sub1.join("test_in_sub1.py").write("def test_1(): pass")
    sub2.join("test_in_sub2.py").write("def test_2(): pass")
    result = testdir.runpytest("-v", "-s")
    result.assert_outcomes(passed=2)
~~~

