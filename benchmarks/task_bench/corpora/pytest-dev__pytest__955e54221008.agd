@x-symbol desc="def test_compilefuncs_and_path_sanity(self, name)" file="testing/code/test_source.py" qual="TestSourceParsingAndCompiling.test_compilefuncs_and_path_sanity" lineno=312 endline=327 [#testing-code-test_source-py--c-testsourceparsingandcompiling--m-test_compilefuncs_and_path_sanity]
~~~
    def test_compilefuncs_and_path_sanity(self, name):
        def check(comp, name):
            co = comp(self.source, name)
            if not name:
                expected = "codegen %s:%d>" % (mypath, mylineno + 2 + 2)
            else:
                expected = "codegen %r %s:%d>" % (name, mypath, mylineno + 2 + 2)
            fn = co.co_filename
            assert fn.endswith(expected)

        mycode = _pytest._code.Code(self.test_compilefuncs_and_path_sanity)
        mylineno = mycode.firstlineno
        mypath = mycode.path

        for comp in _pytest._code.compile, _pytest._code.Source.compile:
            check(comp, name)
~~~

