~~~
class MoreQuietAction(argparse.Action):
    """
    a modified copy of the argparse count action which counts down and updates
    the legacy quiet attribute at the same time

    used to unify verbosity handling
    """

    def __init__(self, option_strings, dest, default=None, required=False, help=None):
        super().__init__(
            option_strings=option_strings,
            dest=dest,
            nargs=0,
            default=default,
            required=required,
            help=help,
        )

    def __call__(self, parser, namespace, values, option_string=None):
        new_count = getattr(namespace, self.dest, 0) - 1
        setattr(namespace, self.dest, new_count)
        # todo Deprecate config.quiet
        namespace.quiet = getattr(namespace, "quiet", 0) + 1
~~~

@x-symbol desc="def __init__(self, option_strings, dest, default=None, required=False, help=None)" file="src/_pytest/terminal.py" qual="MoreQuietAction.__init__" lineno=33 endline=41 refs="#src-_pytest-terminal-py--c-terminalreporter--m-__init__" [#src-_pytest-terminal-py--c-morequietaction--m-__init__]
~~~
    def __init__(self, option_strings, dest, default=None, required=False, help=None):
        super().__init__(
            option_strings=option_strings,
            dest=dest,
            nargs=0,
            default=default,
            required=required,
            help=help,
        )
~~~

