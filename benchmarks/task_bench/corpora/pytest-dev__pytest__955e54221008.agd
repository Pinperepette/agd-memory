def test_maxsize_error_on_instance():
    class A:
        def __repr__(self):
            raise ValueError("...")

    s = saferepr(("*" * 50, A()), maxsize=25)
    assert len(s) == 25
    assert s[0] == "(" and s[-1] == ")"
~~~

@x-symbol desc="def test_exceptions()" file="testing/io/test_saferepr.py" qual="test_exceptions" lineno=26 endline=45 [#testing-io-test_saferepr-py--f-test_exceptions]
~~~
def test_exceptions():
    class BrokenRepr:
        def __init__(self, ex):
            self.ex = ex

        def __repr__(self):
            raise self.ex

    class BrokenReprException(Exception):
        __str__ = None
        __repr__ = None

    assert "Exception" in saferepr(BrokenRepr(Exception("broken")))
    s = saferepr(BrokenReprException("really broken"))
    assert "TypeError" in s
    assert "TypeError" in saferepr(BrokenRepr("string"))

    s2 = saferepr(BrokenRepr(BrokenReprException("omg even worse")))
    assert "NameError" not in s2
    assert "unknown" in s2
~~~

@x-symbol desc="def test_buggy_builtin_repr()" file="testing/io/test_saferepr.py" qual="test_buggy_builtin_repr" lineno=48 endline=56 [#testing-io-test_saferepr-py--f-test_buggy_builtin_repr]
~~~
def test_buggy_builtin_repr():
    # Simulate a case where a repr for a builtin raises.
    # reprlib dispatches by type name, so use "int".

    class int:
        def __repr__(self):
            raise ValueError("Buggy repr!")

    assert "Buggy" in saferepr(int())
~~~

