~~~
def pytest_runtest_setup(item):
    if is_potential_nosetest(item):
        if not call_optional(item.obj, "setup"):
            # call module level setup if there is no object level one
            call_optional(item.parent.obj, "setup")
        # XXX this implies we only call teardown when setup worked
        item.session._setupstate.addfinalizer((lambda: teardown_nose(item)), item)
~~~

@x-symbol desc="def teardown_nose(item)" file="src/_pytest/nose.py" qual="teardown_nose" lineno=17 endline=20 refs="#src-_pytest-nose-py--f-is_potential_nosetest,#src-_pytest-nose-py--f-call_optional" [#src-_pytest-nose-py--f-teardown_nose]
~~~
def teardown_nose(item):
    if is_potential_nosetest(item):
        if not call_optional(item.obj, "teardown"):
            call_optional(item.parent.obj, "teardown")
~~~

@x-symbol desc="def is_potential_nosetest(item)" file="src/_pytest/nose.py" qual="is_potential_nosetest" lineno=23 endline=28 [#src-_pytest-nose-py--f-is_potential_nosetest]
~~~
def is_potential_nosetest(item):
    # extra check needed since we do not do nose style setup/teardown
    # on direct unittest style classes
    return isinstance(item, python.Function) and not isinstance(
        item, unittest.TestCaseFunction
    )
~~~

@x-symbol desc="def call_optional(obj, name)" file="src/_pytest/nose.py" qual="call_optional" lineno=31 endline=38 [#src-_pytest-nose-py--f-call_optional]
~~~
def call_optional(obj, name):
    method = getattr(obj, name, None)
    isfixture = hasattr(method, "_pytestfixturefunction")
    if method is not None and not isfixture and callable(method):
        # If there's any problems allow the exception to raise rather than
        # silently ignoring them
        method()
        return True
~~~

