@x-symbol desc="def listoutcomes(self)" file="src/_pytest/pytester.py" qual="HookRecorder.listoutcomes" lineno=282 endline=295 refs="#src-_pytest-pytester-py--c-hookrecorder--m-getreports" [#src-_pytest-pytester-py--c-hookrecorder--m-listoutcomes]
~~~
    def listoutcomes(self):
        passed = []
        skipped = []
        failed = []
        for rep in self.getreports("pytest_collectreport pytest_runtest_logreport"):
            if rep.passed:
                if rep.when == "call":
                    passed.append(rep)
            elif rep.skipped:
                skipped.append(rep)
            else:
                assert rep.failed, "Unexpected outcome: {!r}".format(rep)
                failed.append(rep)
        return passed, skipped, failed
~~~

