@x-symbol desc="class Instance(PyCollector)" file="src/_pytest/python.py" qual="Instance" lineno=764 endline=779 refs="#src-_pytest-python-py--c-pyobjmixin--m-obj-2,#src-_pytest-python-py--c-instance--m-collect,#src-_pytest-python-py--c-function--m-_getobj" [#src-_pytest-python-py--c-instance]
~~~
class Instance(PyCollector):
    _ALLOW_MARKERS = False  # hack, destroy later
    # instances share the object with their parents in a way
    # that duplicates markers instances if not taken out
    # can be removed at node structure reorganization time

    def _getobj(self):
        return self.parent.obj()

    def collect(self):
        self.session._fixturemanager.parsefactories(self)
        return super().collect()

    def newinstance(self):
        self.obj = self._getobj()
        return self.obj
~~~

