@x-symbol desc="class PytestArg" file="src/_pytest/pytester.py" qual="PytestArg" lineno=152 endline=159 refs="#src-_pytest-pytester-py--c-hookrecorder" [#src-_pytest-pytester-py--c-pytestarg]
~~~
class PytestArg:
    def __init__(self, request):
        self.request = request

    def gethookrecorder(self, hook):
        hookrecorder = HookRecorder(hook._pm)
        self.request.addfinalizer(hookrecorder.finish_recording)
        return hookrecorder
~~~

