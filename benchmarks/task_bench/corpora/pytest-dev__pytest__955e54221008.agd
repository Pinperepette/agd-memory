@x-symbol desc="def toterminal(self, out)" file="src/_pytest/reports.py" qual="BaseReport.toterminal" lineno=38 endline=52 refs="#src-_pytest-reports-py--c-collecterrorrepr--m-toterminal,#src-_pytest-reports-py--f-getslaveinfoline" [#src-_pytest-reports-py--c-basereport--m-toterminal]
~~~
    def toterminal(self, out):
        if hasattr(self, "node"):
            out.line(getslaveinfoline(self.node))

        longrepr = self.longrepr
        if longrepr is None:
            return

        if hasattr(longrepr, "toterminal"):
            longrepr.toterminal(out)
        else:
            try:
                out.line(longrepr)
            except UnicodeEncodeError:
                out.line("<unprintable longrepr>")
~~~

