@x-symbol desc="def test_setup_failure_does_not_kill_capturing(testdir)" file="testing/test_capture.py" qual="test_setup_failure_does_not_kill_capturing" lineno=685 endline=697 [#testing-test_capture-py--f-test_setup_failure_does_not_kill_capturing]
~~~
def test_setup_failure_does_not_kill_capturing(testdir):
    sub1 = testdir.mkpydir("sub1")
    sub1.join("conftest.py").write(
        textwrap.dedent(
            """\
            def pytest_runtest_setup(item):
                raise ValueError(42)
            """
        )
    )
    sub1.join("test_mod.py").write("def test_func1(): pass")
    result = testdir.runpytest(testdir.tmpdir, "--traceconfig")
    result.stdout.fnmatch_lines(["*ValueError(42)*", "*1 error*"])
