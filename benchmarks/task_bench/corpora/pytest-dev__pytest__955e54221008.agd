@x-symbol desc="def test_findsource()" file="testing/code/test_source.py" qual="test_findsource" lineno=450 endline=467 [#testing-code-test_source-py--f-test_findsource]
~~~
def test_findsource():
    from _pytest._code.source import findsource

    co = _pytest._code.compile(
        """if 1:
    def x():
        pass
"""
    )

    src, lineno = findsource(co)
    assert "if 1:" in str(src)

    d = {}
    eval(co, d)
    src, lineno = findsource(d["x"])
    assert "if 1:" in str(src)
    assert src[lineno] == "    def x():"
~~~

@x-symbol desc="def test_getfslineno()" file="testing/code/test_source.py" qual="test_getfslineno" lineno=470 endline=496 [#testing-code-test_source-py--f-test_getfslineno]
~~~
def test_getfslineno():
    from _pytest._code import getfslineno

    def f(x):
        pass

    fspath, lineno = getfslineno(f)

    assert fspath.basename == "test_source.py"
    assert lineno == _pytest._code.getrawcode(f).co_firstlineno - 1  # see findsource

    class A:
        pass

    fspath, lineno = getfslineno(A)

    _, A_lineno = inspect.findsource(A)
    assert fspath.basename == "test_source.py"
    assert lineno == A_lineno

    assert getfslineno(3) == ("", -1)

    class B:
        pass

    B.__name__ = "B2"
    assert getfslineno(B)[1] == -1
~~~

@x-symbol desc="def test_code_of_object_instance_with_call()" file="testing/code/test_source.py" qual="test_code_of_object_instance_with_call" lineno=499 endline=516 [#testing-code-test_source-py--f-test_code_of_object_instance_with_call]
~~~
def test_code_of_object_instance_with_call():
    class A:
        pass

    pytest.raises(TypeError, lambda: _pytest._code.Source(A()))

    class WithCall:
        def __call__(self):
            pass

    code = _pytest._code.Code(WithCall())
    assert "pass" in str(code.source())

    class Hello:
        def __call__(self):
            pass

    pytest.raises(TypeError, lambda: _pytest._code.Code(Hello))
~~~

@x-symbol desc="def getstatement(lineno, source)" file="testing/code/test_source.py" qual="getstatement" lineno=519 endline=524 [#testing-code-test_source-py--f-getstatement]
~~~
def getstatement(lineno, source):
    from _pytest._code.source import getstatementrange_ast

    source = _pytest._code.Source(source, deindent=False)
    ast, start, end = getstatementrange_ast(lineno, source)
    return source[start:end]
~~~

