@x-symbol desc="class SysModulesSnapshot" file="src/_pytest/pytester.py" qual="SysModulesSnapshot" lineno=426 endline=437 refs="#src-_pytest-pytester-py--c-hookrecorder--m-clear" [#src-_pytest-pytester-py--c-sysmodulessnapshot]
~~~
class SysModulesSnapshot:
    def __init__(self, preserve=None):
        self.__preserve = preserve
        self.__saved = dict(sys.modules)

    def restore(self):
        if self.__preserve:
            self.__saved.update(
                (k, m) for k, m in sys.modules.items() if self.__preserve(k)
            )
        sys.modules.clear()
        sys.modules.update(self.__saved)
~~~

