@x-symbol desc="def pytest_runtest_call(item)" file="src/_pytest/runner.py" qual="pytest_runtest_call" lineno=113 endline=126 refs="#src-_pytest-runner-py--f-_update_current_test_var" [#src-_pytest-runner-py--f-pytest_runtest_call]
~~~
def pytest_runtest_call(item):
    _update_current_test_var(item, "call")
    sys.last_type, sys.last_value, sys.last_traceback = (None, None, None)
    try:
        item.runtest()
    except Exception:
        # Store trace info to allow postmortem debugging
        type, value, tb = sys.exc_info()
        tb = tb.tb_next  # Skip *this* frame
        sys.last_type = type
        sys.last_value = value
        sys.last_traceback = tb
        del type, value, tb  # Get rid of these in this frame
        raise
~~~

