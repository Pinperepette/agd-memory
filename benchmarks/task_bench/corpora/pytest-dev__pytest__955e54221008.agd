~~~
    def teardown_exact(self, item, nextitem):
        needed_collectors = nextitem and nextitem.listchain() or []
        self._teardown_towards(needed_collectors)
~~~

@x-symbol desc="def _teardown_towards(self, needed_collectors)" file="src/_pytest/runner.py" qual="SetupState._teardown_towards" lineno=324 endline=338 refs="#src-_pytest-runner-py--c-setupstate--m-_pop_and_teardown" [#src-_pytest-runner-py--c-setupstate--m-_teardown_towards]
~~~
    def _teardown_towards(self, needed_collectors):
        exc = None
        while self.stack:
            if self.stack == needed_collectors[: len(self.stack)]:
                break
            try:
                self._pop_and_teardown()
            except TEST_OUTCOME:
                # XXX Only first exception will be seen by user,
                #     ideally all should be reported.
                if exc is None:
                    exc = sys.exc_info()
        if exc:
            _, val, tb = exc
            raise val.with_traceback(tb)
~~~

@x-symbol desc="def prepare(self, colitem)" file="src/_pytest/runner.py" qual="SetupState.prepare" lineno=340 endline=357 refs="#src-_pytest-runner-py--c-setupstate--m-_teardown_towards" [#src-_pytest-runner-py--c-setupstate--m-prepare]
~~~
    def prepare(self, colitem):
        """ setup objects along the collector chain to the test-method
            and teardown previously setup objects."""
        needed_collectors = colitem.listchain()
        self._teardown_towards(needed_collectors)

        # check if the last collection node has raised an error
        for col in self.stack:
            if hasattr(col, "_prepare_exc"):
                _, val, tb = col._prepare_exc
                raise val.with_traceback(tb)
        for col in needed_collectors[len(self.stack) :]:
            self.stack.append(col)
            try:
                col.setup()
            except TEST_OUTCOME:
                col._prepare_exc = sys.exc_info()
                raise
~~~

@x-symbol desc="def collect_one_node(collector)" file="src/_pytest/runner.py" qual="collect_one_node" lineno=360 endline=367 refs="#src-_pytest-runner-py--f-pytest_make_collect_report,#src-_pytest-runner-py--f-check_interactive_exception" [#src-_pytest-runner-py--f-collect_one_node]
~~~
def collect_one_node(collector):
    ihook = collector.ihook
    ihook.pytest_collectstart(collector=collector)
    rep = ihook.pytest_make_collect_report(collector=collector)
    call = rep.__dict__.pop("call", None)
    if call and check_interactive_exception(call, rep):
        ihook.pytest_exception_interact(node=collector, call=call, report=rep)
    return rep
~~~

