@x-symbol desc="def _warn_about_missing_assertion(mode)" file="src/_pytest/config/__init__.py" qual="_warn_about_missing_assertion" lineno=1066 endline=1081 refs="#src-_pytest-config-__init__-py--f-_assertion_supported" [#src-_pytest-config-__init__-py--f-_warn_about_missing_assertion]
~~~
def _warn_about_missing_assertion(mode):
    if not _assertion_supported():
        if mode == "plain":
            sys.stderr.write(
                "WARNING: ASSERTIONS ARE NOT EXECUTED"
                " and FAILING TESTS WILL PASS.  Are you"
                " using python -O?"
            )
        else:
            sys.stderr.write(
                "WARNING: assertions not in test modules or"
                " plugins will be ignored"
                " because assert statements are not executed "
                "by the underlying Python interpreter "
                "(are you using python -O?)\n"
            )
~~~

@x-symbol desc="def setns(obj, dic)" file="src/_pytest/config/__init__.py" qual="setns" lineno=1084 endline=1103 [#src-_pytest-config-__init__-py--f-setns]
~~~
def setns(obj, dic):
    import pytest

    for name, value in dic.items():
        if isinstance(value, dict):
            mod = getattr(obj, name, None)
            if mod is None:
                modname = "pytest.%s" % name
                mod = types.ModuleType(modname)
                sys.modules[modname] = mod
                mod.__all__ = []
                setattr(obj, name, mod)
            obj.__all__.append(name)
            setns(mod, value)
        else:
            setattr(obj, name, value)
            obj.__all__.append(name)
            # if obj != pytest:
            #    pytest.__all__.append(name)
            setattr(pytest, name, value)
~~~

@x-symbol desc="def create_terminal_writer(config, *args, **kwargs)" file="src/_pytest/config/__init__.py" qual="create_terminal_writer" lineno=1106 endline=1116 [#src-_pytest-config-__init__-py--f-create_terminal_writer]
~~~
def create_terminal_writer(config, *args, **kwargs):
    """Create a TerminalWriter instance configured according to the options
    in the config object. Every code which requires a TerminalWriter object
    and has access to a config object should use this function.
    """
    tw = py.io.TerminalWriter(*args, **kwargs)
    if config.option.color == "yes":
        tw.hasmarkup = True
    if config.option.color == "no":
        tw.hasmarkup = False
    return tw
~~~

@x-symbol desc="def _strtobool(val)" file="src/_pytest/config/__init__.py" qual="_strtobool" lineno=1119 endline=1134 [#src-_pytest-config-__init__-py--f-_strtobool]
~~~
def _strtobool(val):
    """Convert a string representation of truth to true (1) or false (0).

    True values are 'y', 'yes', 't', 'true', 'on', and '1'; false values
    are 'n', 'no', 'f', 'false', 'off', and '0'.  Raises ValueError if
    'val' is anything else.

    .. note:: copied from distutils.util
    """
    val = val.lower()
    if val in ("y", "yes", "t", "true", "on", "1"):
        return 1
    elif val in ("n", "no", "f", "false", "off", "0"):
        return 0
    else:
        raise ValueError("invalid truth value {!r}".format(val))
~~~

