@x-symbol desc="def test_deprecated_call_no_warning(self, mode)" file="testing/test_recwarn.py" qual="TestDeprecatedCall.test_deprecated_call_no_warning" lineno=121 endline=135 [#testing-test_recwarn-py--c-testdeprecatedcall--m-test_deprecated_call_no_warning]
~~~
    def test_deprecated_call_no_warning(self, mode):
        """Ensure deprecated_call() raises the expected failure when its block/function does
        not raise a deprecation warning.
        """

        def f():
            pass

        msg = "No warnings of type (.*DeprecationWarning.*, .*PendingDeprecationWarning.*)"
        with pytest.raises(pytest.fail.Exception, match=msg):
            if mode == "call":
                pytest.deprecated_call(f)
            else:
                with pytest.deprecated_call():
                    f()
~~~

@x-symbol desc="def test_deprecated_call_modes(self, warning_type, mode, call_f_first)" file="testing/test_recwarn.py" qual="TestDeprecatedCall.test_deprecated_call_modes" lineno=143 endline=159 [#testing-test_recwarn-py--c-testdeprecatedcall--m-test_deprecated_call_modes]
~~~
    def test_deprecated_call_modes(self, warning_type, mode, call_f_first):
        """Ensure deprecated_call() captures a deprecation warning as expected inside its
        block/function.
        """

        def f():
            warnings.warn(warning_type("hi"))
            return 10

        # ensure deprecated_call() can capture the warning even if it has already been triggered
        if call_f_first:
            assert f() == 10
        if mode == "call":
            assert pytest.deprecated_call(f) == 10
        else:
            with pytest.deprecated_call():
                assert f() == 10
~~~

@x-symbol desc="def test_deprecated_call_exception_is_raised(self, mode)" file="testing/test_recwarn.py" qual="TestDeprecatedCall.test_deprecated_call_exception_is_raised" lineno=162 endline=175 [#testing-test_recwarn-py--c-testdeprecatedcall--m-test_deprecated_call_exception_is_raised]
~~~
    def test_deprecated_call_exception_is_raised(self, mode):
        """If the block of the code being tested by deprecated_call() raises an exception,
        it must raise the exception undisturbed.
        """

        def f():
            raise ValueError("some exception")

        with pytest.raises(ValueError, match="some exception"):
            if mode == "call":
                pytest.deprecated_call(f)
            else:
                with pytest.deprecated_call():
                    f()
~~~

