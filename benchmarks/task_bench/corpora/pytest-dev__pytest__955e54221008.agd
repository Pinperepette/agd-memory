@x-symbol desc="def test_boolop(self)" file="testing/test_assertrewrite.py" qual="TestAssertionRewrite.test_boolop" lineno=315 endline=392 refs="#testing-test_assertrewrite-py--f-getmsg" [#testing-test_assertrewrite-py--c-testassertionrewrite--m-test_boolop]
