@x-symbol desc="def _check_initialpaths_for_relpath(session, fspath)" file="src/_pytest/nodes.py" qual="_check_initialpaths_for_relpath" lineno=345 endline=348 [#src-_pytest-nodes-py--f-_check_initialpaths_for_relpath]
~~~
def _check_initialpaths_for_relpath(session, fspath):
    for initial_path in session._initialpaths:
        if fspath.common(initial_path) == initial_path:
            return fspath.relto(initial_path)
~~~

@x-symbol desc="class FSCollector(Collector)" file="src/_pytest/nodes.py" qual="FSCollector" lineno=351 endline=372 refs="#src-_pytest-nodes-py--c-item--m-__init__,#src-_pytest-nodes-py--f-_check_initialpaths_for_relpath" [#src-_pytest-nodes-py--c-fscollector]
~~~
class FSCollector(Collector):
    def __init__(self, fspath, parent=None, config=None, session=None, nodeid=None):
        fspath = py.path.local(fspath)  # xxx only for test_resultlog.py?
        name = fspath.basename
        if parent is not None:
            rel = fspath.relto(parent.fspath)
            if rel:
                name = rel
            name = name.replace(os.sep, SEP)
        self.fspath = fspath

        session = session or parent.session

        if nodeid is None:
            nodeid = self.fspath.relto(session.config.rootdir)

            if not nodeid:
                nodeid = _check_initialpaths_for_relpath(session, fspath)
            if nodeid and os.sep != SEP:
                nodeid = nodeid.replace(os.sep, SEP)

        super().__init__(name, parent, config, session, nodeid=nodeid, fspath=fspath)
~~~

