@x-symbol desc="def pytest_collectreport(self, report)" file="src/_pytest/terminal.py" qual="TerminalReporter.pytest_collectreport" lineno=496 endline=504 refs="#src-_pytest-terminal-py--c-terminalreporter--m-report_collect" [#src-_pytest-terminal-py--c-terminalreporter--m-pytest_collectreport]
~~~
    def pytest_collectreport(self, report):
        if report.failed:
            self.stats.setdefault("error", []).append(report)
        elif report.skipped:
            self.stats.setdefault("skipped", []).append(report)
        items = [x for x in report.result if isinstance(x, pytest.Item)]
        self._numcollected += len(items)
        if self.isatty:
            self.report_collect()
~~~

@x-symbol desc="def report_collect(self, final=False)" file="src/_pytest/terminal.py" qual="TerminalReporter.report_collect" lineno=506 endline=544 refs="#src-_pytest-terminal-py--c-terminalreporter--m-rewrite,#src-_pytest-terminal-py--c-terminalreporter--m-write_line,#src-_pytest-terminal-py--c-terminalreporter--m-write" [#src-_pytest-terminal-py--c-terminalreporter--m-report_collect]
~~~
    def report_collect(self, final=False):
        if self.config.option.verbose < 0:
            return

        if not final:
            # Only write "collecting" report every 0.5s.
            t = time.time()
            if (
                self._collect_report_last_write is not None
                and self._collect_report_last_write > t - REPORT_COLLECTING_RESOLUTION
            ):
                return
            self._collect_report_last_write = t

        errors = len(self.stats.get("error", []))
        skipped = len(self.stats.get("skipped", []))
        deselected = len(self.stats.get("deselected", []))
        selected = self._numcollected - errors - skipped - deselected
        if final:
            line = "collected "
        else:
            line = "collecting "
        line += (
            str(self._numcollected) + " item" + ("" if self._numcollected == 1 else "s")
        )
        if errors:
            line += " / %d errors" % errors
        if deselected:
            line += " / %d deselected" % deselected
        if skipped:
            line += " / %d skipped" % skipped
        if self._numcollected > selected > 0:
            line += " / %d selected" % selected
        if self.isatty:
            self.rewrite(line, bold=True, erase=True)
            if final:
                self.write("\n")
        else:
            self.write_line(line)
~~~

@x-symbol desc="def pytest_sessionstart(self, session)" file="src/_pytest/terminal.py" qual="TerminalReporter.pytest_sessionstart" lineno=547 endline=571 refs="#src-_pytest-terminal-py--c-terminalreporter--m-write_sep,#src-_pytest-terminal-py--c-terminalreporter--m-write_line,#src-_pytest-terminal-py--c-terminalreporter--m-pytest_report_header,#src-_pytest-terminal-py--c-terminalreporter--m-_write_report_lines_from_hooks" [#src-_pytest-terminal-py--c-terminalreporter--m-pytest_sessionstart]
~~~
    def pytest_sessionstart(self, session):
        self._session = session
        self._sessionstarttime = time.time()
        if not self.showheader:
            return
        self.write_sep("=", "test session starts", bold=True)
        verinfo = platform.python_version()
        msg = "platform {} -- Python {}".format(sys.platform, verinfo)
        if hasattr(sys, "pypy_version_info"):
            verinfo = ".".join(map(str, sys.pypy_version_info[:3]))
            msg += "[pypy-{}-{}]".format(verinfo, sys.pypy_version_info[3])
        msg += ", pytest-{}, py-{}, pluggy-{}".format(
            pytest.__version__, py.__version__, pluggy.__version__
        )
        if (
            self.verbosity > 0
            or self.config.option.debug
            or getattr(self.config.option, "pastebin", None)
        ):
            msg += " -- " + str(sys.executable)
        self.write_line(msg)
        lines = self.config.hook.pytest_report_header(
            config=self.config, startdir=self.startdir
        )
        self._write_report_lines_from_hooks(lines)
~~~

@x-symbol desc="def _write_report_lines_from_hooks(self, lines)" file="src/_pytest/terminal.py" qual="TerminalReporter._write_report_lines_from_hooks" lineno=573 endline=576 refs="#src-_pytest-terminal-py--c-terminalreporter--m-write_line" [#src-_pytest-terminal-py--c-terminalreporter--m-_write_report_lines_from_hooks]
~~~
    def _write_report_lines_from_hooks(self, lines):
        lines.reverse()
        for line in collapse(lines):
            self.write_line(line)
