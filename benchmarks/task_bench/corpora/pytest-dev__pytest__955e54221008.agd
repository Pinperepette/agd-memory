@x-symbol desc="def _test_pytest_function(pyfuncitem)" file="src/_pytest/debugging.py" qual="_test_pytest_function" lineno=274 endline=283 refs="#src-_pytest-debugging-py--c-pytestpdb--m-_init_pdb" [#src-_pytest-debugging-py--f-_test_pytest_function]
~~~
def _test_pytest_function(pyfuncitem):
    _pdb = pytestPDB._init_pdb("runcall")
    testfunction = pyfuncitem.obj
    pyfuncitem.obj = _pdb.runcall
    if "func" in pyfuncitem._fixtureinfo.argnames:  # pragma: no branch
        raise ValueError("--trace can't be used with a fixture named func!")
    pyfuncitem.funcargs["func"] = testfunction
    new_list = list(pyfuncitem._fixtureinfo.argnames)
    new_list.append("func")
    pyfuncitem._fixtureinfo.argnames = tuple(new_list)
~~~

@x-symbol desc="def _enter_pdb(node, excinfo, rep)" file="src/_pytest/debugging.py" qual="_enter_pdb" lineno=286 endline=312 refs="#src-_pytest-debugging-py--f-_postmortem_traceback,#src-_pytest-debugging-py--f-post_mortem" [#src-_pytest-debugging-py--f-_enter_pdb]
~~~
def _enter_pdb(node, excinfo, rep):
    # XXX we re-use the TerminalReporter's terminalwriter
    # because this seems to avoid some encoding related troubles
    # for not completely clear reasons.
    tw = node.config.pluginmanager.getplugin("terminalreporter")._tw
    tw.line()

    showcapture = node.config.option.showcapture

    for sectionname, content in (
        ("stdout", rep.capstdout),
        ("stderr", rep.capstderr),
        ("log", rep.caplog),
    ):
        if showcapture in (sectionname, "all") and content:
            tw.sep(">", "captured " + sectionname)
            if content[-1:] == "\n":
                content = content[:-1]
            tw.line(content)

    tw.sep(">", "traceback")
    rep.toterminal(tw)
    tw.sep(">", "entering PDB")
    tb = _postmortem_traceback(excinfo)
    rep._pdbshown = True
    post_mortem(tb)
    return rep
~~~

@x-symbol desc="def _postmortem_traceback(excinfo)" file="src/_pytest/debugging.py" qual="_postmortem_traceback" lineno=315 endline=321 [#src-_pytest-debugging-py--f-_postmortem_traceback]
~~~
def _postmortem_traceback(excinfo):
    if isinstance(excinfo.value, UnexpectedException):
        # A doctest.UnexpectedException is not useful for post_mortem.
        # Use the underlying exception instead:
        return excinfo.value.exc_info[2]
    else:
        return excinfo._excinfo[2]
~~~

@x-symbol desc="def post_mortem(t)" file="src/_pytest/debugging.py" qual="post_mortem" lineno=324 endline=329 refs="#src-_pytest-debugging-py--c-pytestpdb--m-_init_pdb" [#src-_pytest-debugging-py--f-post_mortem]
~~~
def post_mortem(t):
    p = pytestPDB._init_pdb("post_mortem")
    p.reset()
    p.interaction(None, t)
    if p.quitting:
        outcomes.exit("Quitting debugger")
~~~

