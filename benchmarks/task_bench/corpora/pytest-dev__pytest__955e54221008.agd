@x-symbol desc="def _iter_rewritable_modules(package_files)" file="src/_pytest/config/__init__.py" qual="_iter_rewritable_modules" lineno=614 endline=623 [#src-_pytest-config-__init__-py--f-_iter_rewritable_modules]
~~~
def _iter_rewritable_modules(package_files):
    for fn in package_files:
        is_simple_module = "/" not in fn and fn.endswith(".py")
        is_package = fn.count("/") == 1 and fn.endswith("__init__.py")
        if is_simple_module:
            module_name, _ = os.path.splitext(fn)
            yield module_name
        elif is_package:
            package_name = os.path.dirname(fn)
            yield package_name
~~~

