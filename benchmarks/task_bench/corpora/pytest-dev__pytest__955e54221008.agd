@x-symbol desc="class ExceptionRepr(TerminalRepr)" file="src/_pytest/_code/code.py" qual="ExceptionRepr" lineno=870 endline=880 [#src-_pytest-_code-code-py--c-exceptionrepr]
~~~
class ExceptionRepr(TerminalRepr):
    def __init__(self):
        self.sections = []

    def addsection(self, name, content, sep="-"):
        self.sections.append((name, content, sep))

    def toterminal(self, tw):
        for name, content, sep in self.sections:
            tw.sep(sep, name)
            tw.line(content)
~~~

